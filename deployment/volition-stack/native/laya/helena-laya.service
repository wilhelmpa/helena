# Helena's local decision server: Laya, browser-tuned, over the System One wire protocol
# (docs/helena-decisions/browser-task.md §3.8). Installed by install.sh next to this file.
[Unit]
Description=Helena local decision server (Laya, browser-tuned)
After=network.target

[Service]
Type=simple
User=helena-laya
Group=helena-laya
Environment=HELENA_LAYA_HOST=127.0.0.1
Environment=HELENA_LAYA_PORT=8791
Environment=HELENA_LAYA_MODEL_DIR=/var/lib/helena-laya/models/laya-browser
Environment=HELENA_LAYA_SUBFOLDER=v10s
Environment=HELENA_LAYA_THREADS=8
Environment=HELENA_LAYA_MAXOPT=12
# Everything was downloaded at install time; the service never reaches the network.
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HOME=/var/lib/helena-laya/hf
# The key the API sends; root owns the file, systemd hands the service a copy.
LoadCredential=laya.key:/etc/helena/laya.key
Environment=HELENA_LAYA_KEY_FILE=%d/laya.key
ExecStart=/opt/helena/laya/venv/bin/python /opt/helena/laya/helena_laya_serve.py
Restart=on-failure
RestartSec=5
# Never starve Helena: a low priority, at most 8 of the 32 threads, a memory ceiling.
Nice=10
CPUQuota=800%
MemoryHigh=3G
MemoryMax=4G
TasksMax=128
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/helena-laya
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
