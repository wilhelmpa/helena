[Unit]
Description=Publish the Kingston Plan LAN endpoint through Avahi
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/volition-lan-avahi-publisher --interface wlp195s0 --address 192.168.2.220 --hostname kingston-server.local --http-port 80 --ssh-port 2222
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=default.target
