# Helena local AI: the embedding model on its own (native/local-ai/embed.sh renders this file).
# Since Halogen took the GPU (docs/helena-decisions/halogen.md), Lemonade no longer runs; the
# semantic search still needs its embedding model. One llama-server from the pinned llama.cpp
# build that install.sh made, serving only Qwen3-Embedding-0.6B (about 1 GB) under the name
# Lemonade gave it, so the vectors already in the index stay valid. Loopback, with the local
# AI key, no downloads.
[Unit]
Description=Helena local AI: embeddings (Qwen3-Embedding-0.6B, llama.cpp)
After=network.target

[Service]
ExecStart=@LLAMA@ --model @MODEL@ --alias @ALIAS@ \
  --embeddings --host 127.0.0.1 --port @PORT@ --api-key-file %d/api-key \
  --ctx-size @CTX@ --batch-size @UBATCH@ --ubatch-size @UBATCH@ --parallel 2 \
  --n-gpu-layers 99 --no-webui
LoadCredential=api-key:/etc/helena/local-ai.key
# The model store belongs to Lemonade's user (local-ai/install.sh), which ran the same binary.
User=lemonade
Group=lemonade
SupplementaryGroups=render video
@ROCBLAS@
ReadOnlyPaths=/var/lib/helena-ai/models
# ROCm's libraries are mapped into the process and count; the weights are small.
MemoryHigh=3G
MemoryMax=6G
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
DevicePolicy=closed
@GPU_DEVICE@
DeviceAllow=char-drm rw
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
