# Helena local AI (native/local-ai/install.sh): agents in isolation have a network namespace of
# their own; their unit forwards 127.0.0.1:13305 to this socket (launcher.json, "localai"),
# which leads to Lemonade on the host's loopback. Only the agents' group may connect.
[Unit]
Description=Helena local AI forwarder for isolated agents

[Socket]
ListenStream=/run/volition-agents/helena-ai.sock
SocketUser=root
SocketGroup=volition-agents
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
