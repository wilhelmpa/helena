# Helena tunnel entry: cloudflared connects here, nothing else can (nftables lets only the
# tunnel's user reach @PORT@; see hardening/files/helena-hardening.nft.in). Rendered by
# deployment/volition-stack/native/cloudflare/install.sh; docs/helena-decisions/security-hardening.md §4.
#
# Three gates stand in front of every request: Cloudflare Access at the edge, cloudflared's
# own Access check (origin setting "Protect with Access"), and the API, which verifies the
# Access assertion on every request marked X-Helena-Entry (auth_request /_helena_edge here,
# and the API's global guard for the rest). There is no LAN owner sign-in on this entry.

# Cloudflare's view of the client, for the rate limits and the audit. A request without it
# did not come through Cloudflare; the API refuses it anyway (no Access assertion).
map $http_cf_connecting_ip $helena_tunnel_client {
    ""       "0.0.0.0";
    default  $http_cf_connecting_ip;
}
map $http_origin $helena_tunnel_origin_ok {
    default                0;
    ""                     1;
    "https://@HOST@"       1;
}

server {
    listen 127.0.0.1:@PORT@;
    server_name @HOST@;
    client_max_body_size 100m;
    server_tokens off;

    # Every location that does not name its own auth_request passes the edge check first.
    auth_request /_helena_edge;

    location = /_helena_edge {
        internal;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        proxy_pass http://127.0.0.1:3000/auth/verify/edge;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    # The tools' session check. The API's guard verifies the Access assertion on this
    # subrequest too (X-Helena-Entry), before /auth/verify looks at the session.
    location = /_plan_auth {
        internal;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        proxy_pass http://127.0.0.1:3000/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }
    location = /_owner_terminal_auth {
        internal;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        proxy_pass http://127.0.0.1:3000/auth/verify/owner-terminal/$owner_terminal_kind;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location = /browser {
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        return 301 /browser/;
    }
    location /browser/ {
        if ($helena_tunnel_origin_ok = 0) { return 403; }
        auth_request /_plan_auth;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        include /etc/nginx/snippets/volition-tool-proxy-security.conf;
        proxy_set_header X-Forwarded-Prefix /browser;
        proxy_pass http://127.0.0.1:6082/;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location = /code {
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        return 301 /code/;
    }
    location /code/ {
        if ($helena_tunnel_origin_ok = 0) { return 403; }
        auth_request /_plan_auth;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        include /etc/nginx/snippets/volition-tool-proxy-security.conf;
        proxy_set_header X-Forwarded-Prefix /code;
        proxy_pass http://127.0.0.1:8443/;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location = /terminal {
        if ($helena_tunnel_origin_ok = 0) { return 403; }
        auth_request /_plan_auth;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        include /etc/nginx/snippets/volition-tool-proxy-security.conf;
        proxy_set_header X-Forwarded-Prefix /terminal;
        proxy_pass http://127.0.0.1:8444/terminal;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://@HOST@" always;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location /terminal/ {
        if ($helena_tunnel_origin_ok = 0) { return 403; }
        auth_request /_plan_auth;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        include /etc/nginx/snippets/volition-tool-proxy-security.conf;
        proxy_set_header X-Forwarded-Prefix /terminal;
        proxy_pass http://127.0.0.1:8444;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://@HOST@" always;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location ~ ^/focus/terminal-project(/.*)?$ {
        if ($helena_tunnel_origin_ok = 0) { return 403; }
        auth_request /_plan_auth;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        include /etc/nginx/snippets/volition-tool-proxy-security.conf;
        proxy_pass http://127.0.0.1:8444;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location ~ ^/focus/owner-terminal/(shell|claude|codex|helena-dev-claude|helena-dev-codex)/ {
        if ($helena_tunnel_origin_ok = 0) { return 403; }
        set $owner_terminal_kind $1;
        auth_request /_owner_terminal_auth;
        auth_request_set $owner_terminal_token $upstream_http_x_owner_terminal_token;
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        include /etc/nginx/snippets/volition-tool-proxy-security.conf;
        proxy_set_header X-Owner-Terminal-Token $owner_terminal_token;
        proxy_pass http://unix:/run/volition-owner-terminal/term.sock:;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location /backend/ {
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        rewrite ^/backend/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:3000;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
    location / {
        include /etc/nginx/snippets/helena-tunnel-headers.conf;
        proxy_pass http://127.0.0.1:3001;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
