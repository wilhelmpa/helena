# Helena: Cloudflare Tunnel connector (outbound only). Installed by
# deployment/volition-stack/native/cloudflare/install.sh; docs/helena-decisions/security-hardening.md §4.
# The tunnel token comes from a root-only file as a systemd credential and never sits in an
# environment variable of the unit or on a command line.
[Unit]
Description=Helena: Cloudflare Tunnel (helena.volition.one)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=helena-tunnel
Group=helena-tunnel
LoadCredential=tunnel-token:/etc/helena/cloudflare/tunnel.token
ExecStart=/usr/local/libexec/helena-cloudflared
Restart=always
RestartSec=5
TimeoutStopSec=30
# cloudflared resolves Cloudflare's edge itself; the unit gets public resolvers of its own,
# so the private-address block below does not cut off DNS (the router is 192.168.2.1).
BindReadOnlyPaths=/etc/helena/cloudflare/resolv.conf:/etc/resolv.conf
# The allowlist also excludes globally routed home IPv6 prefixes.
# Required edges: https://developers.cloudflare.com/tunnel/configuration/
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=1.1.1.1 1.0.0.1 2606:4700:4700::1111
IPAddressAllow=198.41.192.0/24 198.41.200.0/24 2606:4700:a0::/48 2606:4700:a8::/48
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A call outside the list fails with EPERM instead of killing the connector.
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
