[Unit]
Description=Volition Mastra to Hermes project-team bridge (development instance)
# The socket lives in the directory the live bridge owns, which systemd removes when the
# live bridge stops; this instance follows it so its socket is created again.
After=volition-hermes-team-bridge.service
PartOf=volition-hermes-team-bridge.service
Requires=volition-hermes-team-bridge.service

[Service]
Type=simple
User=volition-mastra
Group=volition
WorkingDirectory=/srv/volition/source/plan-dev/deployment/volition-stack/integration
LoadCredential=hermes_team_token:/etc/volition/dev/hermes-team.token
LoadCredential=plan_control_token:/etc/volition/dev/plan-control.token
Environment=HERMES_TEAM_TOKEN_FILE=%d/hermes_team_token
Environment=PLAN_CONTROL_TOKEN_FILE=%d/plan_control_token
Environment=HERMES_TEAM_SOCKET=/run/volition-ipc/hermes-team-dev.sock
Environment=PLAN_INTERNAL_URL=http://127.0.0.1:3100
ExecStart=/usr/local/bin/node /srv/volition/source/plan-dev/deployment/volition-stack/integration/hermes-team-bridge.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/volition-ipc

[Install]
WantedBy=volition-hermes-team-bridge.service
