#!/usr/bin/env python3
"""Updates the Hermes installation Helena's agents run on, with a way back.

Started as root by helena-hermes-update.path when the runner writes a request into the spool
(`request.json`, a check or an apply the owner approved in Helena), or by hand:

    helena-hermes-update [--config FILE] check
    helena-hermes-update [--config FILE] --offline check  # cached Git refs only
    helena-hermes-update [--config FILE] apply <target>
    helena-hermes-update [--config FILE] serve-request

An online check fetches the upstream; --offline uses only locally cached Git refs and reports
the installed and the newest cached version, the upstream commits between them (the changelog) and the commits carried on top of upstream locally. An
apply moves the checkout to <target> (a commit or tag of the upstream branch, or `latest`),
carries the local commits over, reinstalls the package into the virtual environment, and
runs a smoke test. Any failure puts the previous checkout and virtual environment back.

Each step runs as the owner of what it changes: git as the owner of the checkout, the
install as the owner of the virtual environment. The answer is JSON on stdout, and for a
spool request also `status.json` in the spool.
"""

from __future__ import annotations

import argparse
import datetime
import fcntl
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

DEFAULT_CONFIG = Path("/etc/helena/hermes-update.json")
TARGET = re.compile(r"^(latest|[0-9a-f]{7,40}|v?\d+(\.\d+){1,3}(-[A-Za-z0-9.]+)?)$")
LOG_LIMIT = 20_000


class UpdateError(Exception):
    pass


def load_config(path: Path) -> dict:
    with open(path, encoding="utf-8") as handle:
        config = json.load(handle)
    for key in ("source", "venv", "spool"):
        if not isinstance(config.get(key), str) or not os.path.isabs(config[key]):
            raise UpdateError(f"config: {key} must be an absolute path")
    config.setdefault("remote", "origin")
    config.setdefault("branch", "main")
    config.setdefault("localBranch", None)
    config.setdefault("track", "releases")
    if config["track"] not in ("releases", "branch"):
        raise UpdateError("config: track must be releases or branch")
    config.setdefault("rollbackDir", "/var/lib/helena/hermes-update")
    config.setdefault(
        "install", ["{venv}/bin/python", "-m", "pip", "install", "--quiet", "-e", "{source}"]
    )
    config.setdefault("smoke", ["{venv}/bin/hermes", "--version"])
    return config


class Runner:
    """Runs commands as the owner of a path when started as root, and keeps a log."""

    def __init__(self) -> None:
        self.log: list[str] = []
        self.returncode = 0

    def note(self, line: str) -> None:
        self.log.append(line)

    def run(self, args: list[str], *, owner_of: str | None = None, cwd: str | None = None,
            env: dict | None = None, check: bool = True) -> str:
        preexec = None
        if owner_of and os.geteuid() == 0:
            info = os.stat(owner_of)
            account = pwd.getpwuid(info.st_uid)

            def preexec() -> None:  # noqa: D401 - drops privileges in the child
                os.setgid(info.st_gid)
                os.initgroups(account.pw_name, info.st_gid)
                os.setuid(info.st_uid)

            env = {**(env or {}), "HOME": account.pw_dir, "USER": account.pw_name}
        self.note("$ " + " ".join(args))
        result = subprocess.run(
            args, cwd=cwd, env={**os.environ, **(env or {})}, preexec_fn=preexec,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=1800)
        output = result.stdout.strip()
        if output:
            self.note(output[-4000:])
        self.returncode = result.returncode
        if check and result.returncode != 0:
            raise UpdateError(f"{args[0]} exited with {result.returncode}")
        return output


# Isolated agents run Hermes from this venv as their project users (a read-only bind keeps
# the modes), so every file must be readable by them: on 2026-09-25 docstring_parser (root
# 0600, linked by uv from a cache written under umask 077) failed every agent on a Claude
# model, since the anthropic SDK imports it. After each install and each rollback the venv is
# opened to every reader: go+rX, go-w (chmod's semantics). The same rules as the isolation's
# runtime_modes.py, which also checks and repairs the venv on every deploy: by file
# descriptor, no link followed, a file with a second name only when root owns it, nothing of
# another owner.
_O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
_O_FILE = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC


def open_to_readers(tree: Path) -> int:
    """Opens every file and folder of `tree` to group and others; returns how many changed."""
    top = os.open(tree, _O_DIR)
    owners = {0, os.fstat(top).st_uid}
    changed = 0

    def open_up(fd: int, info: os.stat_result) -> None:
        nonlocal changed
        mode = stat.S_IMODE(info.st_mode)
        wanted = (mode | 0o044) & ~0o022
        if stat.S_ISDIR(info.st_mode) or mode & 0o111:
            wanted |= 0o011
        # Only what others cannot read yet: a readable tree stays exactly as uv left it.
        readable = mode & 0o005 == 0o005 if stat.S_ISDIR(info.st_mode) else (
            mode & 0o004 and not (mode & 0o100 and not mode & 0o001))
        if readable or info.st_uid not in owners:
            return
        if stat.S_ISREG(info.st_mode) and info.st_nlink > 1 and info.st_uid != 0:
            return
        os.fchmod(fd, wanted)
        changed += 1

    def visit(dir_fd: int, depth: int) -> None:
        if depth > 64:
            return
        for name in os.listdir(dir_fd):
            info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
            if stat.S_ISDIR(info.st_mode):
                flags = _O_DIR
            elif stat.S_ISREG(info.st_mode):
                flags = _O_FILE
            else:
                continue
            try:
                child = os.open(name, flags, dir_fd=dir_fd)
            except OSError:
                continue
            try:
                opened = os.fstat(child)
                if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
                    continue
                open_up(child, opened)
                if stat.S_ISDIR(opened.st_mode):
                    visit(child, depth + 1)
            finally:
                os.close(child)

    try:
        open_up(top, os.fstat(top))
        visit(top, 0)
    finally:
        os.close(top)
    return changed


# The committer of the local commits carried over; their author stays.
COMMITTER = ["-c", "user.name=Helena update", "-c", "user.email=helena-update@localhost"]


def git(runner: Runner, config: dict, *args: str, check: bool = True) -> str:
    source = config["source"]
    return runner.run(
        ["git", "-c", f"safe.directory={source}", *COMMITTER, "-C", source, *args],
        owner_of=source, check=check)


def version_at(runner: Runner, config: dict, ref: str) -> str | None:
    text = git(runner, config, "show", f"{ref}:pyproject.toml", check=False)
    match = re.search(r'^version\s*=\s*"([^"]+)"', text, re.M)
    return match.group(1) if match else None


def describe(runner: Runner, config: dict, ref: str) -> dict:
    described = git(runner, config, "describe", "--tags", "--always", ref, check=False)
    return {
        "commit": git(runner, config, "rev-parse", ref).splitlines()[-1],
        "describe": described.splitlines()[-1] if described else None,
        "version": version_at(runner, config, ref),
    }


def upstream(config: dict) -> str:
    return f"{config['remote']}/{config['branch']}"


RELEASE_TAG = re.compile(r"^v?\d+(\.\d+){1,3}$")


# What "the newest version" is. Hermes' main moves by hundreds of commits a day, so by default
# (`"track": "releases"`) it is the newest release tag on the upstream branch; `"track": "branch"`
# follows the branch head as before. Without any release tag the branch head is used.
def latest_ref(runner: Runner, config: dict) -> str:
    if config.get("track", "releases") == "branch":
        return upstream(config)
    tags = git(runner, config, "tag", "--merged", upstream(config), "--sort=-v:refname", check=False)
    for tag in tags.splitlines():
        if RELEASE_TAG.fullmatch(tag.strip()):
            return tag.strip()
    return upstream(config)


def log_lines(runner: Runner, config: dict, spec: str, limit: int = 200) -> list[dict]:
    out = git(runner, config, "log", "--no-merges", f"--max-count={limit}",
              "--format=%H%x09%cs%x09%s", spec, check=False)
    commits = []
    for line in out.splitlines():
        parts = line.split("\t", 2)
        if len(parts) == 3 and re.fullmatch(r"[0-9a-f]{40}", parts[0]):
            commits.append({"commit": parts[0], "date": parts[1], "subject": parts[2][:300]})
    return commits


def check(config: dict, runner: Runner, *, offline: bool = False) -> dict:
    # An operator can refresh the installed version from local Git refs without network.
    # The newest release then means newest *cached* tag; no remote freshness is implied.
    if not offline:
        git(runner, config, "fetch", "--tags", "--prune", config["remote"])
    latest = latest_ref(runner, config)
    base = git(runner, config, "merge-base", "HEAD", latest).splitlines()[-1]
    latest_commit = git(runner, config, "rev-parse", f"{latest}^{{commit}}").splitlines()[-1]
    # A release tag can lag behind the installed main-canary checkout even when its
    # package version looks larger. Commit ancestry, rather than semver, decides this.
    latest_is_ancestor = base == latest_commit
    return {
        "current": describe(runner, config, "HEAD"),
        "latest": describe(runner, config, latest),
        # What updating to the newest version brings, newest first. Empty when the checkout
        # already contains it (also when it runs ahead of the newest release).
        "commits": [] if latest_is_ancestor else log_lines(runner, config, f"{base}..{latest}"),
        "latestIsAncestor": latest_is_ancestor,
        # The commits carried on top of upstream, which an update carries over.
        "localPatches": log_lines(runner, config, f"{upstream(config)}..HEAD", 50),
    }


def resolve_target(runner: Runner, config: dict, target: str) -> str:
    if not TARGET.fullmatch(target):
        raise UpdateError("the target is not a commit, a version tag or latest")
    ref = latest_ref(runner, config) if target == "latest" else target
    commit = git(runner, config, "rev-parse", "--verify", f"{ref}^{{commit}}", check=False).splitlines()
    if not commit or not re.fullmatch(r"[0-9a-f]{40}", commit[-1]):
        raise UpdateError(f"{target} is not known upstream")
    commit = commit[-1]
    ancestor = subprocess.run(
        ["git", "-c", f"safe.directory={config['source']}", "-C", config["source"],
         "merge-base", "--is-ancestor", commit, upstream(config)])
    if ancestor.returncode != 0:
        raise UpdateError(f"{target} is not on {upstream(config)}")
    return commit


# git refuses to check out a branch another worktree holds (the dev worktree next to the live
# checkout keeps the local branch), so the live checkout then stays detached on the result.
def checked_out_elsewhere(runner: Runner, config: dict, branch: str) -> bool:
    here = os.path.realpath(config["source"])
    path = None
    for line in git(runner, config, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = os.path.realpath(line[len("worktree "):])
        elif line == f"branch refs/heads/{branch}" and path != here:
            return True
    return False


def fill(args: list[str], config: dict) -> list[str]:
    return [arg.format(venv=config["venv"], source=config["source"]) for arg in args]


def apply(config: dict, runner: Runner, target: str) -> dict:
    git(runner, config, "fetch", "--tags", "--prune", config["remote"])
    commit = resolve_target(runner, config, target)
    before = describe(runner, config, "HEAD")
    old_branch = git(runner, config, "rev-parse", "--abbrev-ref", "HEAD").splitlines()[-1]
    local_branch = config["localBranch"] or (old_branch if old_branch != "HEAD" else None)
    base = git(runner, config, "merge-base", "HEAD", upstream(config)).splitlines()[-1]
    patches = [entry["commit"] for entry in reversed(log_lines(runner, config, f"{base}..HEAD", 50))]
    if git(runner, config, "status", "--porcelain", "--untracked-files=no"):
        raise UpdateError("the checkout has uncommitted changes")

    venv = Path(config["venv"])
    # The copy lives in a folder only root writes, so nobody can put a link where it goes.
    keep = Path(config["rollbackDir"])
    keep.mkdir(mode=0o700, parents=True, exist_ok=True)
    rollback = keep / "venv"
    if rollback.is_symlink():
        rollback.unlink()
    elif rollback.exists():
        shutil.rmtree(rollback)
    # cp -a keeps owners and modes, which a copy made as root would otherwise lose.
    runner.run(["cp", "-a", "--reflink=auto", str(venv), str(rollback)])
    work = f"helena/update-{datetime.datetime.now(datetime.timezone.utc):%Y%m%d%H%M%S}"
    try:
        git(runner, config, "checkout", "-q", "-B", work, commit)
        for patch in patches:
            git(runner, config, "cherry-pick", "--allow-empty", patch, check=False)
            if runner.returncode != 0:
                raise UpdateError(f"the local commit {patch[:10]} does not apply to {target}")
        runner.run(fill(config["install"], config), owner_of=str(venv), cwd=config["source"])
        opened = open_to_readers(venv)
        if opened:
            runner.note(f"opened {opened} entries of the venv to every reader")
        with tempfile.TemporaryDirectory() as home:
            os.chmod(home, 0o777)
            smoke = runner.run(fill(config["smoke"], config), owner_of=str(venv),
                               env={"HERMES_HOME": home})
        if local_branch and not checked_out_elsewhere(runner, config, local_branch):
            git(runner, config, "checkout", "-q", "-B", local_branch, work)
        else:
            if local_branch:
                runner.note(f"{local_branch} is checked out in another worktree; "
                            "the checkout stays detached")
            git(runner, config, "checkout", "-q", "--detach", work)
        git(runner, config, "branch", "-q", "-D", work, check=False)
        after = describe(runner, config, "HEAD")
        return {"from": before, "to": after, "smoke": smoke[-500:], "carried": len(patches)}
    except Exception as error:
        runner.note(f"rolling back: {error}")
        git(runner, config, "cherry-pick", "--abort", check=False)
        if old_branch != "HEAD":
            git(runner, config, "checkout", "-q", "-f", "-B", old_branch, before["commit"], check=False)
        else:
            git(runner, config, "checkout", "-q", "-f", before["commit"], check=False)
        git(runner, config, "branch", "-q", "-D", work, check=False)
        shutil.rmtree(venv, ignore_errors=True)
        shutil.move(str(rollback), str(venv))
        try:
            open_to_readers(venv)
        except OSError as problem:
            runner.note(f"the restored venv could not be opened to every reader: {problem}")
        if git(runner, config, "rev-parse", "HEAD").splitlines()[-1] != before["commit"]:
            raise UpdateError("update failed; rollback needs operator check") from error
        raise UpdateError(f"update failed; previous version restored: {error}") from error


# The spool belongs to the runner's user, who could put a link where root writes: every file
# is created anew under a random name (O_EXCL) or opened without following a link.
def write_status(spool: Path, status: dict) -> None:
    fd, temp = tempfile.mkstemp(dir=spool, prefix=".status-")
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(status, ensure_ascii=False, indent=1) + "\n")
    os.chmod(temp, 0o644)
    os.replace(temp, spool / "status.json")


def read_request(path: Path) -> str | None:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    with os.fdopen(fd, encoding="utf-8") as handle:
        return handle.read(4096)


def serve_request(config: dict) -> dict:
    spool = Path(config["spool"])
    request_path = spool / "request.json"
    raw = read_request(request_path)
    if raw is None:
        return {"ok": False, "error": "no request"}
    request_path.unlink()
    try:
        request = json.loads(raw)
        request_id = str(request["id"])[:64]
        action = request["action"]
        if action not in ("check", "apply"):
            raise UpdateError("unknown action")
        offline = request.get("offline", False)
        if not isinstance(offline, bool) or (offline and action != "check"):
            raise UpdateError("offline is only available for check")
    except (ValueError, KeyError, TypeError, UpdateError) as error:
        answer = {"ok": False, "error": f"invalid request: {error}"}
        write_status(spool, {"id": None, "state": "failed", **answer})
        return answer
    write_status(spool, {"id": request_id, "action": action, "state": "running"})
    answer = run(config, action, request.get("target"), offline=offline)
    write_status(spool, {"id": request_id, "action": action,
                         "state": "done" if answer["ok"] else "failed", **answer})
    return answer


def run(config: dict, action: str, target: str | None, *, offline: bool = False) -> dict:
    runner = Runner()
    lock_path = Path(config["spool"]) / "lock"
    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if offline and action != "check":
                raise UpdateError("--offline is only available for check")
            result = (check(config, runner, offline=offline) if action == "check"
                      else apply(config, runner, str(target)))
            return {"ok": True, "result": result, "log": "\n".join(runner.log)[-LOG_LIMIT:]}
        except Exception as error:  # noqa: BLE001 - every failure is the answer
            return {"ok": False, "error": str(error)[:500], "log": "\n".join(runner.log)[-LOG_LIMIT:]}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="helena-hermes-update")
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    parser.add_argument("--offline", action="store_true", help="check cached Git refs without fetching")
    parser.add_argument("action", choices=["check", "apply", "serve-request"])
    parser.add_argument("target", nargs="?")
    args = parser.parse_args(argv)
    config = load_config(args.config)
    Path(config["spool"]).mkdir(parents=True, exist_ok=True)
    if args.action == "serve-request":
        if args.offline:
            parser.error("--offline cannot be used with serve-request")
        answer = serve_request(config)
    else:
        if args.action == "apply" and not args.target:
            parser.error("apply needs a target")
        answer = run(config, args.action, args.target, offline=args.offline)
    print(json.dumps(answer, ensure_ascii=False))
    return 0 if answer.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
