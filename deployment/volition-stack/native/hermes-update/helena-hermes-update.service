[Unit]
Description=Helena: check or apply a Hermes update (with rollback)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root only to act as the owner of each part: git as the owner of the Hermes checkout, the
# install as the owner of the virtual environment (the helper drops to them per step).
# Runs as root by default; no explicit User=root: with it systemd sets up the login
# environment and the helper's setuid() to the checkout's owner fails with EPERM
# ("Exception occurred in preexec_fn"), so neither a check nor an update could run.
ExecStart=/usr/local/libexec/helena-hermes-update --config /etc/helena/hermes-update.json serve-request
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/volition/source/hermes /var/lib/volition/hermes /var/lib/helena/hermes-update
# uv (the install step) needs a writable cache. It runs as the owner of the venv (root)
# with HOME=/root, which ProtectHome makes read-only ("Failed to initialize cache at
# /root/.cache/uv"). A venv of another owner would need that owner's cache here.
CacheDirectory=helena-hermes-update
Environment=UV_CACHE_DIR=/var/cache/helena-hermes-update
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
