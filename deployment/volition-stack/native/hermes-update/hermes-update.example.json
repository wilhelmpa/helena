{
  "source": "/srv/volition/source/hermes",
  "venv": "/var/lib/volition/hermes/venv",
  "spool": "/var/lib/volition/hermes/run/helena-update",
  "remote": "origin",
  "branch": "main",
  "localBranch": "volition/main",
  "install": ["/usr/local/bin/uv", "pip", "install", "--quiet", "--python", "{venv}/bin/python", "-e", "{source}"],
  "smoke": ["{venv}/bin/hermes", "--version"]
}
