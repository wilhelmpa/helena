#!/bin/bash
set -euo pipefail

if (( $# != 1 )) || [[ ! "$1" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; then
  printf 'invalid project slug\n' >&2
  exit 64
fi

# With agent isolation the terminal runs as the project's user, in the same sandbox as its
# agents, through the agent launcher; the owner sees exactly what the agents may do.
if [[ "${AGENT_ISOLATION:-}" == on ]]; then
  export TERM=xterm-256color
  exec /usr/bin/python3 -I /usr/local/lib/volition-isolation/launch_client.py terminal "$1"
fi

root=/srv/volition/workspaces/projects
root="$(realpath -e -- "$root")"
if [[ "$1" == home ]]; then
  # Home is no project of its own: its terminal opens where the Home agent works.
  target="$(dirname -- "$root")"
else
  target="$(realpath -e -- "$root/$1")" || {
    printf 'project directory does not exist\n' >&2
    exit 66
  }
  if [[ ! -d "$target" || "$target" != "$root/"* ]]; then
    printf 'project directory escapes workspace root\n' >&2
    exit 77
  fi
fi

export TERM=xterm-256color
exec /usr/bin/tmux -f "$(dirname -- "$(realpath -- "$0")")/tmux.conf" \
  new-session -A -s "volition-$1" -c "$target" /bin/bash -l
