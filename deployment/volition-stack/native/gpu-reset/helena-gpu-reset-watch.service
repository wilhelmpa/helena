[Unit]
Description=Restart Helena GPU services after amdgpu reset
After=systemd-journald.service
Requires=systemd-journald.service

[Service]
Type=simple
ExecStart=/usr/local/lib/helena-ai/gpu-reset-watch
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/helena-ai

[Install]
WantedBy=multi-user.target
