# Installed by deployment/volition-stack/native/updates/install.sh: the API hands the update
# center's requests to the root helper through its spool, and takes the database dump before
# a Debian upgrade into the backups folder.
[Service]
Environment=HELENA_UPDATE_SPOOL=@SPOOL@
Environment=HELENA_UPDATE_BACKUP_DIR=@BACKUPS@
# One mount for the whole spool: the API writes into tmp/ and renames into requests/, and a
# rename across two separate ReadWritePaths bind mounts fails with EXDEV. status/ and the
# spool itself stay root's by their permissions.
ReadWritePaths=@SPOOL@
