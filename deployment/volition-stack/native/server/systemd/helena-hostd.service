[Unit]
Description=Helena host helper (disks and RAID, backups, power and fans)
Documentation=file:/usr/local/lib/helena/hostd/README.md
Requires=helena-hostd.socket
After=helena-hostd.socket

[Service]
Type=simple
# Root is needed to read SMART data, to write the md and EC attributes and the EFI boot
# entries, and to start the backup units. Every operation and its parameters are fixed in
# helena_host/service.py; only the API's user (config "callers") may connect.
ExecStart=/usr/bin/python3 -I /usr/local/lib/helena/hostd/helena-hostd serve
Environment=HELENA_HOSTD_CONFIG=/etc/helena/hostd.json
StateDirectory=helena/hostd
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
# /etc stays writable for the backup timer's schedule drop-in; /sys for the md sync_action,
# the EC's fan attributes and efivars (so no ProtectKernelTunables).
ProtectSystem=true
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
InaccessiblePaths=-/etc/volition

[Install]
WantedBy=multi-user.target
