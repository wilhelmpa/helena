#!/usr/bin/env bash
# Starts the project browsers (and Home's) that were provisioned, after a boot. Each one's
# runtime.json names it; a state that is not exactly what provisioning writes is skipped.
# The state belongs to volition-hermes, or to volition-browser once agent isolation handed
# it over (isolation.sh); before this accepted only the first, and after the switch no
# browser came back by itself (Home's not at all: provisioning restarts only projects').
set -euo pipefail

root=/var/lib/volition/project-browser/projects
[[ -d "$root" ]] || exit 0

shopt -s nullglob
for state in "$root"/*/runtime.json; do
  slug="$(basename "$(dirname "$state")")"
  [[ "$slug" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || continue
  [[ ! -L "$state" && -f "$state" ]] || continue
  case "$(stat -c '%U:%a' "$state")" in
    volition-hermes:600 | volition-browser:600) ;;
    *) continue ;;
  esac
  [[ "$(jq -r '.schemaVersion // empty' "$state")" == '1' ]] || continue
  [[ "$(jq -r '.slug // empty' "$state")" == "$slug" ]] || continue
  project_id="$(jq -r '.projectId // empty' "$state")"
  if [[ "$slug" == home ]]; then
    [[ "$project_id" == 0 ]] || continue
  else
    [[ "$project_id" =~ ^[1-9][0-9]*$ ]] || continue
  fi
  /usr/bin/systemctl start "volition-project-browser@${slug}.target"
done
