# Helena Notizen: what nginx lets through to SilverBullet, the same on every entry (the home
# network's second port and the tunnel's own name). Rendered by notes/install.sh into
# /etc/nginx/snippets/helena-notes-common.conf; included at server level.
# docs/helena-decisions/notes-silverbullet.md §3.
#
# The notes run on an origin of their own, never under Helena's: a note can hold script
# (Space Lua, ${...} expressions) that runs in the browser of whoever opens the notes, and
# agents write notes. On Helena's origin such a script would act with the owner's session.

# Every request needs the owner: his Helena session at home, his Cloudflare Access identity
# through the tunnel (the entry's /_helena_notes_auth says which). No API key, ever.
auth_request /_helena_notes_auth;
error_page 401 = @helena_notes_signin;
server_tokens off;
client_max_body_size 100m;

# On every answer, nginx's own included. Helena may frame the notes; a note's script may talk
# to this origin only (no fetch, image or form towards Helena or anywhere else).
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; frame-ancestors @FRAME_ANCESTORS@" always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy no-referrer always;
add_header Cross-Origin-Resource-Policy same-origin always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()" always;

location @helena_notes_signin {
    default_type text/html;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors @FRAME_ANCESTORS@" always;
    add_header Cache-Control "no-store" always;
    return 401 '<!doctype html><html lang="de"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notizen</title><body style="font:14px/1.5 system-ui,sans-serif;margin:2rem;color:#444"><p>Die Notizen brauchen deine Anmeldung bei Helena.</p><p><a href="$helena_notes_helena/" target="_top">Bei Helena anmelden</a>, dann diese Seite neu laden.</p></body></html>';
}

# SilverBullet's client code and service worker, without a session: they hold no content,
# and SilverBullet's documentation asks for exactly these two exceptions (the service worker
# refreshes itself in the background, where a sign-in page would break it).
location = /service_worker.js {
    auth_request off;
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}
location ^~ /.client/ {
    auth_request off;
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}

# The files. Never a hidden path (.git, .trash, .gitignore, a dotfile anywhere) and never
# Private/, whatever the method; SilverBullet's own ignore rules only hide them from its list.
# (Plain prefix locations, not ^~: the two refusals below are regexes and must be checked.)
location ~ ^/\.fs/(.*/)?\. {
    return 404;
}
location ~ ^/\.fs/Private(/|$) {
    return 404;
}
location = /.fs {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}
location /.fs/ {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}

# What the client needs besides the files: its settings, the live change events and a ping.
location = /.config {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}
location = /.events {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}
location = /.ping {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}
location = /.accounts {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}

# Everything else of SilverBullet's own is closed: shell, server-side fetch (/.proxy), the
# headless runtime, revisions, the dashboard, its sign-in and metrics.
location ^~ /. {
    return 404;
}
location = /metrics {
    return 404;
}

# The pages: SilverBullet answers every page name with its client.
location / {
    include /etc/nginx/snippets/helena-notes-proxy.conf;
}
