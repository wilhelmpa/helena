# The SilverBullet release Helena's Notizen run (notes/install.sh). Pinned: a new release is
# taken only after re-checking docs/helena-decisions/notes-silverbullet.md §2 (single-space
# mode, the SB_* names below, what /.fs answers) and the checksums from the release page
# (GitHub shows each asset's sha256).
HELENA_NOTES_VERSION=2.11.1
HELENA_NOTES_BASE_URL=https://github.com/silverbulletmd/silverbullet/releases/download/2.11.1
HELENA_NOTES_SHA256_X86_64=82af0d5d008c377cdb4b49dbd21db0d21f8d14619efa40b0fdeae1dce778d018
HELENA_NOTES_SHA256_AARCH64=4ca826b88431fcbe8d4c8f4d7d3f8cc3b076d42f724a40b6dc4d45a676d9dd87
