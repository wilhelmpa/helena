# Notizen: Einstellungen

Helena hat diese Seite angelegt (notes/install.sh). Sie stellt die Notizen auf Helenas Wissensordner ein: das Tagebuch liegt dort, wo Helena die Tagesnotizen führt, Links werden kurz geschrieben wie in Helena, und `ordner:<Pfad>` zeigt Notizen und Dateien eines Ordners. Änderungen hier gelten nach dem nächsten Neuladen.

```space-lua
-- priority: 50
config.set("journal.prefix", "@JOURNAL_FOLDER@/")
config.set("linkWriteFormat", "shortest")
config.set("view.defaults", {
  ["std.spaceTree"] = { dock = "lhs", open = true, width = 260 },
})

-- Helena's address for each address of the notes (a task link opens there).
local helenaOrigins = {
@HELENA_ORIGINS@
}

local function helenaOrigin()
  return helenaOrigins[js.window.location.host] or ""
end

-- "ordner:Projects/VOL" lists notes and files in a folder, newest first. Helena
-- opens a project or the current Files folder here.
virtualPage.define {
  pattern = "ordner:(.+)",
  run = function(folder)
    local prefix = folder .. "/"
    local pages = query[[
      from p = index.pages()
      where p.name:startsWith(prefix)
      order by p.lastModified desc
      limit 300
    ]]
    local documents = query[[
      from d = index.documents()
      where d.name:startsWith(prefix)
      order by d.lastModified desc
      limit 300
    ]]
    local lines = {
      "# " .. folder,
      "",
      "Neue Notiz hier: Strg/⌘-K, `" .. prefix .. "Name` eingeben, Umschalt-Enter.",
      "",
    }
    if #pages == 0 and #documents == 0 then
      table.insert(lines, "Noch keine Notizen oder Dateien in diesem Ordner.")
    end
    if #pages > 0 then
      table.insert(lines, "## Notizen")
      for _, p in ipairs(pages) do
        table.insert(lines, "* [[" .. p.name .. "]] · " .. string.sub(p.lastModified or "", 1, 10))
      end
      table.insert(lines, "")
    end
    if #documents > 0 then
      table.insert(lines, "## Dateien")
      for _, d in ipairs(documents) do
        local label = string.sub(d.name, #prefix + 1):gsub("[\r\n]", " ")
        label = string.gsub(label, "\\", "\\\\")
        label = string.gsub(label, "%[", "(")
        label = string.gsub(label, "%]", ")")
        label = string.gsub(label, "<", "(")
        label = string.gsub(label, ">", ")")
        local date = string.sub(d.lastModified or "", 1, 10)
        -- SilverBullet decodes destinations while rendering and again on navigation.
        -- A reserved character can therefore turn into a fragment, query or malformed
        -- escape. Show such files safely; Helena's Files view can open them by path.
        if string.find(d.name, "[#?%%<>]") then
          table.insert(lines, "* " .. label .. " · " .. date .. " (in Helena-Dateien öffnen)")
        else
          -- Encode spaces, UTF-8 and brackets before the Markdown parser sees them.
          local href = "/" .. string.gsub(d.name, "([^%w%-%._~/])", function(char)
            return string.format("%%%02X", string.byte(char))
          end)
          table.insert(lines, "* [" .. label .. "](<" .. href .. ">) · " .. date)
        end
      end
    end
    return table.concat(lines, "\n")
  end
}

-- [[VOL-12]] is a task in Helena: its page links there.
virtualPage.define {
  pattern = "^(%u[%u%d_]*)-(%d+)$",
  run = function(key, number)
    local origin = helenaOrigin()
    local lines = { "# " .. key .. "-" .. number, "" }
    if origin ~= "" then
      table.insert(lines, "[Aufgabe in Helena öffnen](" .. origin .. "/project/" .. key .. "/issue/" .. number .. ")")
    else
      table.insert(lines, "Eine Aufgabe in Helena.")
    end
    return table.concat(lines, "\n")
  end
}
```
