  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#827b89", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#7051b5" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#227a58" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#b95a0a" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#86550a" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#a54c37" } },
    { "scope": ["variable.language", "variable.parameter", "entity.name.tag"], "settings": { "foreground": "#c51d6c" } }
  ],
  "semanticTokenColors": {
    "class": "#a54c37",
    "interface": "#a54c37",
    "type": "#a54c37",
    "function": "#86550a",
    "method": "#86550a",
    "parameter": "#c51d6c",
    "variable.readonly": "#7051b5",
    "property": "#201b29"
  }
