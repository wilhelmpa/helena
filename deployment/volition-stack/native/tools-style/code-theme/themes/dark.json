  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#88808f", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#bdaaff" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#7ee0b8" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ff912e" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#f4c46a" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#f0997b" } },
    { "scope": ["variable.language", "variable.parameter", "entity.name.tag"], "settings": { "foreground": "#f5459e" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#cfc6da" } }
  ],
  "semanticTokenColors": {
    "class": "#f0997b",
    "interface": "#f0997b",
    "type": "#f0997b",
    "function": "#f4c46a",
    "method": "#f4c46a",
    "parameter": "#f5459e",
    "variable.readonly": "#bdaaff",
    "property": "#eeeaf6"
  }
