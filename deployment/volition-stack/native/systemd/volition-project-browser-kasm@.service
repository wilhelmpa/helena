[Unit]
Description=Volition project %i KasmVNC display
PartOf=volition-project-browser@%i.target
Before=volition-project-browser-chromium@%i.service
ConditionPathExists=/var/lib/volition/project-browser/projects/%i/runtime.env

[Service]
# Network: Chromium's CDP and KasmVNC listen on 127.0.0.1 only. Isolated agents cannot reach
# them: each agent unit has a network namespace of its own (PrivateNetwork=yes), so its
# loopback is not this one. IPAddressDeny=, RestrictNetworkInterfaces= and SocketBindDeny=
# are not used here: they need cgroup BPF, which this nspawn container does not offer, and
# were measured to have no effect (see isolation/README.md).
Type=simple
# With agent isolation the browser user alone owns the project profiles (0700): isolation.sh
# switches this unit to volition-browser (drop-in browser-user.conf) in the same step that
# hands it the state; a deploy alone must not, or the unit could not read its own state.
User=volition-hermes
Group=volition
EnvironmentFile=/var/lib/volition/project-browser/projects/%i/runtime.env
ExecStartPre=/usr/bin/test -s ${PROJECT_BROWSER_XAUTHORITY}
# 1920x1080 display pixels (Full HD; 3840x2160 before, a quarter of the framebuffer now).
# Chromium draws at device scale factor 2 (see the Chromium unit), and its windows are sized to
# the live view's or the agent's page (window keeper, ../../browser/project-browser-control.mjs),
# not to the display: a window larger than the display is still drawn in full, so the live
# view's frames stay one to one and clicks exact (project-browser-resize-x11-proof.mjs with
# HELENA_PROOF_SCREEN=1920x1080), and the video path grows the display to the page it grabs
# (fitScreen, project-browser-video.mjs). The desktop (VNC) view resizes the display to its panel.
ExecStart=/usr/bin/Xvnc ${PROJECT_BROWSER_DISPLAY} -geometry 1920x1080 -depth 24 -auth ${PROJECT_BROWSER_XAUTHORITY} -interface 127.0.0.1 -websocketPort ${PROJECT_BROWSER_NOVNC_PORT} -rfbport 0 -localhost -nolisten tcp -httpd /usr/share/kasmvnc/www -SecurityTypes None -DisableBasicAuth -AcceptSetDesktopSize -udpFullFrameFrequency 0 -publicIP 127.0.0.1
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/volition/project-browser/projects/%i
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
