[Unit]
Description=Volition project browser loopback router
After=network.target
Wants=network.target
# Restarted however often it fails; RestartSteps spaces the attempts out to a minute.
StartLimitIntervalSec=0

[Service]
# Network: Chromium's CDP and KasmVNC listen on 127.0.0.1 only. Isolated agents cannot reach
# them: each agent unit has a network namespace of its own (PrivateNetwork=yes), so its
# loopback is not this one. IPAddressDeny=, RestrictNetworkInterfaces= and SocketBindDeny=
# are not used here: they need cgroup BPF, which this nspawn container does not offer, and
# were measured to have no effect (see isolation/README.md).
Type=simple
# The browser user alone owns the project profiles (0700): no agent and not the runner
# can read their cookies and sessions.
User=volition-browser
Group=volition
Environment=PROJECT_BROWSER_ROOT=/var/lib/volition/project-browser/projects
Environment=PROJECT_BROWSER_ROUTER_PORT=6082
ExecStart=/usr/local/bin/node /srv/volition/source/plan/deployment/volition-stack/browser/project-router.mjs
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=60
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/var/lib/volition/project-browser/projects
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
