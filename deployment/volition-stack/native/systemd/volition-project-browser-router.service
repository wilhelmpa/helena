[Unit]
Description=Volition project browser loopback router
After=network.target
Wants=network.target
# Restarted however often it fails; RestartSteps spaces the attempts out to a minute.
StartLimitIntervalSec=0

[Service]
# Network: Chromium's CDP and KasmVNC listen on 127.0.0.1 only. Isolated agents cannot reach
# them: each agent unit has a network namespace of its own (PrivateNetwork=yes), so its
# loopback is not this one. IPAddressDeny=, RestrictNetworkInterfaces= and SocketBindDeny=
# are not used here: they need cgroup BPF, which this nspawn container does not offer, and
# were measured to have no effect (see isolation/README.md).
Type=simple
# With agent isolation the browser user alone owns the project profiles (0700): isolation.sh
# switches this unit to volition-browser (drop-in browser-user.conf) in the same step that
# hands it the state; a deploy alone must not, or the unit could not read its own state.
User=volition-hermes
Group=volition
Environment=PROJECT_BROWSER_ROOT=/var/lib/volition/project-browser/projects
Environment=PROJECT_BROWSER_ROUTER_PORT=6082
# The browser gateway's sockets, one directory per project browser (browser-gateway-server.mjs).
# Kept across restarts: the isolation launcher binds a project's directory into its running
# agent units, which a directory created anew would leave behind. The gateway itself starts
# only with its token (install-browser-gateway.sh adds it as a drop-in).
RuntimeDirectory=volition-browser
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
# Per-project page color preferences live outside the read-only browser profiles.
StateDirectory=volition-browser-router
StateDirectoryMode=0700
ExecStart=/usr/local/bin/node /srv/volition/source/plan/deployment/volition-stack/browser/project-router.mjs
Restart=always
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=60
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/var/lib/volition/project-browser/projects
# The browser gateway has the project browsers save downloads below its TMPDIR, until it
# hands them to Helena (the project's Inbox) and removes them: a directory the Chromium units
# may write as well (install-browser-gateway.sh creates it).
Environment=TMPDIR=/var/lib/volition/project-browser/downloads
ReadWritePaths=-/var/lib/volition/project-browser/downloads
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
