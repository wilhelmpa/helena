[Unit]
Description=Volition project %i persistent Chromium
PartOf=volition-project-browser@%i.target
Requires=volition-project-browser-kasm@%i.service
After=volition-project-browser-kasm@%i.service
ConditionPathExists=/var/lib/volition/project-browser/projects/%i/runtime.env

[Service]
# Network: Chromium's CDP and KasmVNC listen on 127.0.0.1 only. Isolated agents cannot reach
# them: each agent unit has a network namespace of its own (PrivateNetwork=yes), so its
# loopback is not this one. IPAddressDeny=, RestrictNetworkInterfaces= and SocketBindDeny=
# are not used here: they need cgroup BPF, which this nspawn container does not offer, and
# were measured to have no effect (see isolation/README.md).
Type=simple
# With agent isolation the browser user alone owns the project profiles (0700): isolation.sh
# switches this unit to volition-browser (drop-in browser-user.conf) in the same step that
# hands it the state; a deploy alone must not, or the unit could not read its own state.
User=volition-hermes
Group=volition
EnvironmentFile=/var/lib/volition/project-browser/projects/%i/runtime.env
ExecStartPre=/usr/local/libexec/volition-wait-for-x
ExecStart=/usr/bin/chromium --ozone-platform=x11 --user-data-dir=${PROJECT_BROWSER_PROFILE} --disk-cache-dir=${PROJECT_BROWSER_CACHE} --remote-debugging-address=127.0.0.1 --remote-debugging-port=${PROJECT_BROWSER_CDP_PORT} --no-first-run --no-default-browser-check --restore-last-session --hide-crash-restore-bubble about:blank
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/volition/project-browser/projects/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=infinity
