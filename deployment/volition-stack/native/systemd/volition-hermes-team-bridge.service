[Unit]
Description=Volition Mastra to Hermes project-team bridge
After=network-online.target volition-plan-api.service volition-hermes-runner.service
Wants=network-online.target
Requires=volition-plan-api.service

[Service]
Type=simple
User=volition-mastra
Group=volition
WorkingDirectory=/srv/volition/source/plan/deployment/volition-stack/integration
RuntimeDirectory=volition-ipc
RuntimeDirectoryMode=0750
LoadCredential=hermes_team_token:/etc/volition/hermes-team.token
LoadCredential=plan_control_token:/etc/volition/plan-control.token
Environment=HERMES_TEAM_TOKEN_FILE=%d/hermes_team_token
Environment=PLAN_CONTROL_TOKEN_FILE=%d/plan_control_token
Environment=HERMES_TEAM_SOCKET=/run/volition-ipc/hermes-team.sock
Environment=PLAN_INTERNAL_URL=http://127.0.0.1:3000
ExecStart=/usr/local/bin/node /srv/volition/source/plan/deployment/volition-stack/integration/hermes-team-bridge.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
