[Unit]
Description=Volition project-scoped web terminals
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=volition-hermes
Group=volition
WorkingDirectory=/srv/volition/source/plan/deployment/volition-stack/native/terminal
RuntimeDirectory=volition-terminal
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/volition/hermes
Environment=WETTY_ALLOW_LOCAL_COMMAND=true
Environment=TERMINAL_HOST=127.0.0.1
Environment=TERMINAL_PORT=8444
Environment=PROJECTS_ROOT=/srv/volition/workspaces/projects
Environment=TERMINAL_RUNTIME_ROOT=/run/volition-terminal
Environment=TERMINAL_ALLOWED_HOSTS=kingston-server.local,kingston-server
ExecStart=/usr/local/bin/node project-terminal-router.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/srv/volition/workspaces /var/lib/volition/hermes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=infinity

[Install]
WantedBy=multi-user.target
