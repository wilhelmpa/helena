[Unit]
Description=Volition Plan Hermes agent runner
After=network-online.target volition-plan-api.service volition-hermes-gateway.service
# Wants rather than Requires: systemd restarts a service with the service it requires,
# and this one rides out the API being down.
Wants=network-online.target volition-plan-api.service
ConditionPathExists=/srv/volition/source/plan/packages/runner/dist/cli.js
ConditionPathExists=/etc/volition/hermes-plan-key
# Restarted however often it fails; RestartSteps spaces the attempts out to a minute.
StartLimitIntervalSec=0

[Service]
Type=simple
User=volition-hermes
Group=volition-hermes-secrets
SupplementaryGroups=volition
WorkingDirectory=/srv/volition/workspaces
Environment=HOME=/var/lib/volition/hermes
Environment=HERMES_HOME=/var/lib/volition/hermes
Environment=HELENA_RUNNER_DRAIN_STATUS=/var/lib/volition/hermes/run/deploy-drain-status.json
LoadCredential=itsaplan_api_key:/etc/volition/hermes-plan-key
ExecStart=/usr/local/libexec/volition-hermes-runner
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
# SIGTERM hands the runs in flight back: their commands get SIGINT and 5 s, then the runner
# reports the hand-backs and exits. A chat claim the server holds (up to 25 s, 35 s client
# deadline) is the longest thing it may still wait for; 90 s leaves room for that, so a stop
# never ends in SIGKILL and runs lost to their leases. (A deployment drain replaces this
# with SIGINT and no timeout: runner-drain/.)
TimeoutStopSec=90
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/volition/hermes /srv/volition/workspaces
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=infinity

[Install]
WantedBy=multi-user.target
