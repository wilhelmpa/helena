[Unit]
Description=Volition Mastra workflow control plane
After=network-online.target volition-hermes-team-bridge.service
Wants=network-online.target
Requires=volition-hermes-team-bridge.service

[Service]
Type=simple
User=volition-mastra
Group=volition
WorkingDirectory=/srv/volition/source/plan/deployment/volition-stack/optional/mastra-studio
StateDirectory=volition/mastra
LoadCredential=hermes_team_token:/etc/volition/hermes-team.token
LoadCredential=mastra_control_token:/etc/volition/mastra-control.token
LoadCredential=mastra_gateway_token:/etc/volition/mastra-gateway.token
Environment=NODE_ENV=production
Environment=MASTRA_TELEMETRY_DISABLED=true
Environment=DO_NOT_TRACK=1
Environment=MASTRA_HIDE_CLOUD_CTA=true
Environment=MASTRA_AUTO_DETECT_URL=true
Environment=MASTRA_AGENT_SIGNALS=false
Environment=MASTRA_FRESH_MODE=false
Environment=MASTRA_HOST=127.0.0.1
Environment=MASTRA_PORT=4111
Environment=STUDIO_PROXY_HOST=127.0.0.1
Environment=STUDIO_DATABASE_URL=file:/var/lib/volition/mastra/mastra.db
Environment=HERMES_TEAM_TOKEN_FILE=%d/hermes_team_token
Environment=HERMES_TEAM_SOCKET=/run/volition-ipc/hermes-team.sock
Environment=MASTRA_CONTROL_TOKEN_FILE=%d/mastra_control_token
Environment=STUDIO_GATEWAY_TOKEN_FILE=%d/mastra_gateway_token
ExecStart=/usr/local/bin/node start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/volition/mastra
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=infinity

[Install]
WantedBy=multi-user.target
