[Unit]
Description=Volition Syncthing (vault sync with the owner's devices)
Documentation=man:syncthing(1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
User=volition-sync
Group=volition-sync
# The setgid vault directories give new files the group volition or volition-private;
# this mask keeps them writable for that group.
UMask=0007
Environment=STNODEFAULTFOLDER=1
Environment=STNOUPGRADE=1
LoadCredential=api_key:/etc/volition/syncthing-api.key
# The key reaches Syncthing through the environment, which only this user can read,
# rather than as an argument, which every local user can read.
ExecStart=/bin/sh -c 'STGUIAPIKEY="$$(cat "%d/api_key")" exec /usr/bin/syncthing serve --home=/var/lib/volition/syncthing --gui-address=http://127.0.0.1:8384 --no-browser --no-restart --logflags=0'
Restart=on-failure
RestartSec=2
SuccessExitStatus=3 4
RestartForceExitStatus=3 4
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/volition/syncthing /srv/volition/vault
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
