[Unit]
Description=Volition project provisioning service
After=network-online.target volition-plan-api.service volition-hermes-runner.service
Wants=network-online.target
Requires=volition-plan-api.service

[Service]
Type=simple
User=volition-hermes
Group=volition
WorkingDirectory=/srv/volition/source/plan/deployment/volition-stack/integration
StateDirectory=volition/provisioning
LoadCredential=provisioning_token:/etc/volition/provisioning.token
LoadCredential=plan_api_key:/etc/volition/hermes-plan-key
LoadCredential=plan_control_token:/etc/volition/plan-control.token
Environment=HOME=/var/lib/volition/hermes
Environment=HERMES_HOME=/var/lib/volition/hermes
Environment=HERMES_BIN=/var/lib/volition/hermes/venv/bin/hermes
Environment=HERMES_AGENTS_ROOT=/var/lib/volition/hermes/agents
Environment=HERMES_RUNNER_DESCRIPTOR_ROOT=/var/lib/volition/hermes/run/agents
Environment=HERMES_RUNNER_SERVICE=volition-hermes-runner.service
Environment=PROVISIONING_HOST=127.0.0.1
Environment=PROVISIONING_PORT=18800
Environment=PROVISIONING_TOKEN_FILE=%d/provisioning_token
Environment=PROVISIONING_STATE_ROOT=/var/lib/volition/provisioning
Environment=PROJECTS_ROOT=/srv/volition/workspaces/projects
Environment=WORKSPACE_RUNTIME_ROOT=/srv/volition/workspaces/projects
Environment=PROVISIONING_REGISTRY_ROOT=/var/lib/volition/provisioning/projects
Environment=VOLITION_VAULT_ROOT=/srv/volition/vault
Environment=PROJECT_TRASH_ROOT=/srv/volition/trash/projects
Environment=PROJECT_BROWSER_ROOT=/var/lib/volition/project-browser/projects
Environment=PROJECT_BROWSER_SYSTEMCTL_SCOPE=system
Environment=SYSTEMCTL_SCOPE=system
Environment=ITSAPLAN_MCP_BEARER_FILE=%d/plan_api_key
Environment=PLAN_CONTROL_TOKEN_FILE=%d/plan_control_token
Environment=MASTRA_CONTROL_ENABLED=true
Environment=MASTRA_CONTROL_URL=http://127.0.0.1:4111/mastra/api/
Environment=MASTRA_CONTROL_TOKEN_FILE=%d/plan_control_token
Environment=MASTRA_CONTROL_OWNER_EMAIL=patrick.wilhelm@volition.one
Environment=PLAN_INTERNAL_URL=http://127.0.0.1:3000
Environment=PLAN_PUBLIC_URL=http://kingston-server.local/
Environment=PROJECT_BROWSER_PUBLIC_URL=http://kingston-server.local/browser/
Environment=CODE_PUBLIC_URL=http://kingston-server.local/code/
Environment=TERMINAL_PUBLIC_URL=http://kingston-server.local/focus/terminal-project/
Environment=INBOX_BASELINES={}
Environment=CONNECTIONS_ENABLED=false
Environment=MAIL_ENABLED=false
Environment=MASTRA_EVENT_INGRESS_ENABLED=false
ExecStart=/usr/local/bin/node /srv/volition/source/plan/deployment/volition-stack/integration/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/volition/provisioning /var/lib/volition/hermes /var/lib/volition/project-browser/projects /srv/volition/workspaces /srv/volition/vault /srv/volition/trash/projects
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
