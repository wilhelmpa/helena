#!/bin/bash
# Execs one of a fixed set of commands, never a caller-supplied one. The router
# (owner-terminal-router.mjs) has already restricted the "kind" query parameter to
# this same fixed list before it gets here (belt and braces: this script re-checks
# it against a literal case, not a variable built from input).
set -euo pipefail

if (( $# != 2 )); then
  printf 'usage: owner-terminal-shell <kind> <session-name>\n' >&2
  exit 64
fi
kind=$1
name=$2
if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; then
  printf 'invalid session name\n' >&2
  exit 64
fi

dev_clone=$HOME/volition/plan

case "$kind" in
  shell)
    command=(bash -l)
    workdir=$HOME
    ;;
  claude)
    command=("$HOME/.local/bin/claude")
    workdir=$HOME
    ;;
  codex)
    command=("$HOME/.local/bin/codex")
    workdir=$HOME
    ;;
  helena-dev-claude)
    # --add-dir also makes Claude Code read that directory's CLAUDE.md as extra
    # project context, which is the handoff (~/volition/CLAUDE.md) the design
    # asks for: the dev clone (~/volition/plan) is its own git repository, and
    # Claude Code does not read a CLAUDE.md above a repository boundary on its own.
    command=("$HOME/.local/bin/claude" --add-dir "$HOME/volition")
    workdir=$dev_clone
    ;;
  helena-dev-codex)
    # Codex's own AGENTS.md discovery walks up from the working directory; no
    # flag equivalent to Claude Code's --add-dir was found for also handing it
    # ~/volition/CLAUDE.md specifically (see the branch report's open items).
    command=("$HOME/.local/bin/codex")
    workdir=$dev_clone
    ;;
  *)
    printf 'unknown session kind\n' >&2
    exit 64
    ;;
esac

if [[ ! -d "$workdir" ]]; then
  printf 'working directory does not exist: %s\n' "$workdir" >&2
  exit 66
fi

export TERM=xterm-256color
# The sessions live in helena-owner-tmux.service (its socket), so they outlive this
# router; without that service tmux falls back to a server of its own, as before.
socket=${OWNER_TERMINAL_TMUX_SOCKET:-/run/helena-owner-tmux/tmux.sock}
socket_args=()
[[ -S "$socket" ]] && socket_args=(-S "$socket")
tmux=(/usr/bin/tmux "${socket_args[@]}" -f "$(dirname -- "$(realpath -- "$0")")/tmux.conf")
session="owner-$kind-$name"

# tmux keeps a program running across restarts of the terminal service, but a reboot ends
# it. A tab that starts again then continues its last conversation instead of an empty one
# (owner, 2026-09-24: "Sitzungen müssen unbedingt persistent sein"). Only decided when the
# tmux session is new; an open tab is simply attached to.
if ! "${tmux[@]}" has-session -t "=$session" 2>/dev/null; then
  state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/helena-owner-terminal
  mkdir -p -m 0700 "$state_dir"
  case "$kind" in
    claude | helena-dev-claude)
      # Each tab keeps one conversation of its own: its id is chosen at the first start
      # and resumed from then on, once Claude Code has written it.
      id_file=$state_dir/$kind-$name.claude-session
      id=$(cat -- "$id_file" 2>/dev/null || true)
      if [[ $id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] &&
        compgen -G "$HOME/.claude/projects/*/$id.jsonl" >/dev/null; then
        command+=(--resume "$id")
      else
        id=$(cat /proc/sys/kernel/random/uuid)
        printf '%s\n' "$id" >"$id_file"
        command+=(--session-id "$id")
      fi
      ;;
    codex | helena-dev-codex)
      # Codex has no id to choose up front; it continues the newest session of the
      # working directory, and starts a new one where there is none.
      command=(bash -c '"$1" resume --last || exec "$1"' codex "${command[0]}")
      ;;
  esac
fi
exec "${tmux[@]}" new-session -A -s "$session" -c "$workdir" "${command[@]}"
