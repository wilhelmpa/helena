#!/usr/sbin/nft -f
# Helena host firewall. Rendered by deployment/volition-stack/native/hardening/apply.sh
# (step "firewall") from helena-hardening.nft.in; do not edit the installed copy by hand.
# docs/helena-decisions/security-hardening.md §3.
#
# The first two lines replace the table atomically, so a reload never leaves a gap.
table inet helena_hardening
delete table inet helena_hardening

table inet helena_hardening {
	# The home network. IPv4 from the interface's own prefix; IPv6 as link-local and
	# unique-local plus eno1's active /64s, which change with the provider's prefix.
	# helena-lan6-sync keeps both current (NetworkManager dispatcher + 5-minute timer).
	set lan4 {
		type ipv4_addr; flags interval
		elements = { @LAN4@ }
	}
	set lan6 {
		type ipv6_addr; flags interval
		elements = { fe80::/10, fc00::/7 }
	}
	# What the home network may reach: SSH, HTTP, HTTPS, Syncthing (sync and
	# local discovery) and mDNS. Nothing is open to the internet: the Cloudflare tunnel only
	# connects out.
	set lan_tcp {
		type inet_service
		elements = { 22, 53, 80, 443, 22000 }
	}
	set lan_udp {
		type inet_service
		elements = { 53, 5353, 21027, 22000 }
	}

	# Loopback services that trust whoever connects, because nginx's auth_request stands
	# in front of them: which local users may connect. uid 0 is in every set.
	set cdp_ports {
		type inet_service; flags interval
		elements = { 9222, 19200-19299 }
	}
	set cdp_uids {
		typeof meta skuid
		elements = { @UIDS_CDP@ }
	}
	set router_ports {
		type inet_service; flags interval
		elements = { 6082, 16080-16099 }
	}
	set router_uids {
		typeof meta skuid
		elements = { @UIDS_ROUTER@ }
	}
	set tool_ports {
		type inet_service
		elements = { 8443, 8444, 18443 }
	}
	set tool_uids {
		typeof meta skuid
		elements = { @UIDS_TOOLS@ }
	}
	set syncthing_gui_ports {
		type inet_service
		elements = { 8384 }
	}
	set syncthing_gui_uids {
		typeof meta skuid
		elements = { @UIDS_SYNCTHING@ }
	}
	# Helena's voice on the GPU (native/local-ai/voice.sh): whisper.cpp and qwentts.cpp have no
	# key of their own; only Helena's API (and root) may reach them.
	set voice_ports {
		type inet_service
		elements = { 13306, 13307, 14306, 14307 }
	}
	set voice_uids {
		typeof meta skuid
		elements = { @UIDS_VOICE@ }
	}
	# The authenticated NPU gateway forwards to an unkeyed FLM worker.
	set volition_npu_ports {
		type inet_service
		elements = { 13310 }
	}
	set volition_npu_uids {
		typeof meta skuid
		elements = { @UIDS_VOLITION_NPU@ }
	}
	set tunnel_ports {
		type inet_service
		elements = { @TUNNEL_PORT@ }
	}
	set tunnel_uids {
		typeof meta skuid
		elements = { @UIDS_TUNNEL@ }
	}

	chain input {
		type filter hook input priority filter - 10; policy drop;
		iif "lo" accept
		ct state established,related accept
		ct state invalid drop
		# IPv6 does not work without neighbour discovery and PMTU messages.
		meta l4proto ipv6-icmp accept
		meta l4proto icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } limit rate 50/second accept
		# Answers of the DHCP servers (router) to this machine's clients.
		udp sport 67 udp dport 68 accept
		# Home network DHCP served by Kingston (helena-dnsmasq, native/lan/heimnetz.sh).
		udp sport 68 udp dport 67 accept comment "helena:dhcp-server"
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		ip saddr @lan4 tcp dport @lan_tcp accept
		ip6 saddr @lan6 tcp dport @lan_tcp accept
		ip saddr @lan4 udp dport @lan_udp accept
		ip6 saddr @lan6 udp dport @lan_udp accept
		limit rate 6/minute log prefix "helena-drop: " level info
		counter comment "helena:input-drop"
	}

	chain output {
		type filter hook output priority filter - 10; policy accept;
		# A process on this machine that connects to nginx from a non-loopback source
		# address (bind to the LAN address, connect to 127.0.0.1) looks like a LAN client
		# to nginx. Local connections to nginx come from loopback, or not at all.
		oif "lo" tcp dport { 80, 443 } ip saddr != 127.0.0.0/8 counter reject with tcp reset comment "helena:self-guard"
		oif "lo" tcp dport { 80, 443 } ip6 saddr != ::1 counter reject with tcp reset comment "helena:self-guard6"
		oif "lo" tcp dport @cdp_ports meta skuid != @cdp_uids counter reject with tcp reset comment "helena:acl-cdp"
		oif "lo" tcp dport @router_ports meta skuid != @router_uids counter reject with tcp reset comment "helena:acl-router"
		oif "lo" tcp dport @tool_ports meta skuid != @tool_uids counter reject with tcp reset comment "helena:acl-tools"
		oif "lo" tcp dport @syncthing_gui_ports meta skuid != @syncthing_gui_uids counter reject with tcp reset comment "helena:acl-syncthing"
		oif "lo" tcp dport @tunnel_ports meta skuid != @tunnel_uids counter reject with tcp reset comment "helena:acl-tunnel"
		oif "lo" tcp dport @voice_ports meta skuid != @voice_uids counter reject with tcp reset comment "helena:acl-voice"
		oif "lo" tcp dport @volition_npu_ports meta skuid != @volition_npu_uids counter reject with tcp reset comment "volition:acl-npu"
	}
}
