[Unit]
Description=Volition project %i persistent Chromium
PartOf=volition-project-browser@%i.target
Requires=volition-project-browser-xvfb@%i.service
After=volition-project-browser-xvfb@%i.service

[Service]
Type=simple
EnvironmentFile=/home/pw/services/volition-stack/browser/projects/%i/runtime.env
Environment=XDG_RUNTIME_DIR=/home/pw/services/volition-stack/browser/projects/%i/run/runtime
Environment=TMPDIR=/home/pw/services/volition-stack/browser/projects/%i/run/tmp
ExecStartPre=/home/pw/services/volition-stack/browser/bin/wait-for-x
ExecStart=/usr/bin/chromium --user-data-dir=${PROJECT_BROWSER_PROFILE} --disk-cache-dir=${PROJECT_BROWSER_CACHE} --remote-debugging-address=127.0.0.1 --remote-debugging-port=${PROJECT_BROWSER_CDP_PORT} --no-first-run --no-default-browser-check --disable-dev-shm-usage --restore-last-session about:blank
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/home/pw/services/volition-stack/browser/projects/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
