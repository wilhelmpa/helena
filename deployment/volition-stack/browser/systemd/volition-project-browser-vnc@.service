[Unit]
Description=Volition project %i browser x11vnc
PartOf=volition-project-browser@%i.target
Requires=volition-project-browser-xvfb@%i.service
After=volition-project-browser-xvfb@%i.service

[Service]
Type=simple
EnvironmentFile=/home/pw/services/volition-stack/browser/projects/%i/runtime.env
ExecStartPre=/home/pw/services/volition-stack/browser/bin/wait-for-x
ExecStart=/home/pw/services/volition-stack/browser/bin/x11vnc-wrapper -display ${PROJECT_BROWSER_DISPLAY} -auth ${PROJECT_BROWSER_XAUTHORITY} -localhost -noipv6 -rfbport ${PROJECT_BROWSER_VNC_PORT} -rfbportv6 -1 -forever -shared -nopw -noxdamage -repeat
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/home/pw/services/volition-stack/browser/projects/%i/run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
