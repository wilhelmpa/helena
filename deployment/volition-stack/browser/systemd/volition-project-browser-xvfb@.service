[Unit]
Description=Volition project %i browser Xvfb
PartOf=volition-project-browser@%i.target
Before=volition-project-browser-chromium@%i.service volition-project-browser-vnc@%i.service

[Service]
Type=simple
EnvironmentFile=/home/pw/services/volition-stack/browser/projects/%i/runtime.env
ExecStartPre=/usr/bin/test -s ${PROJECT_BROWSER_XAUTHORITY}
ExecStart=/usr/bin/Xvfb ${PROJECT_BROWSER_DISPLAY} -screen 0 1920x1080x24 -nolisten tcp -noreset -auth ${PROJECT_BROWSER_XAUTHORITY}
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/home/pw/services/volition-stack/browser/projects/%i/run
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
