[Unit]
Description=Volition isolated browser for project %i
Requires=volition-project-browser-xvfb@%i.service
Requires=volition-project-browser-chromium@%i.service
Requires=volition-project-browser-vnc@%i.service
Requires=volition-project-browser-novnc@%i.service
After=volition-project-browser-xvfb@%i.service
After=volition-project-browser-chromium@%i.service
After=volition-project-browser-vnc@%i.service
After=volition-project-browser-novnc@%i.service

[Install]
WantedBy=default.target
