[Unit]
Description=Volition project workspace provisioning service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pw/services/itsaplan/deployment/volition-stack/integration
Environment=HOME=/home/pw
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PROVISIONING_HOST=172.30.254.1
Environment=PROVISIONING_PORT=18800
Environment=PROJECTS_ROOT=/home/pw/services/volition-workspaces/projects
Environment=PROVISIONING_STATE_ROOT=/home/pw/services/volition-workspaces/.state
Environment=PROJECT_BROWSER_ROOT=/var/lib/volition/project-browser/projects
Environment=PROJECT_BROWSER_PUBLIC_URL=https://plan.volition.one/browser/
Environment=CODE_PUBLIC_URL=https://plan.volition.one/workspace/code/
Environment=TERMINAL_PUBLIC_URL=https://plan.volition.one/focus/terminal-project/
LoadCredential=provisioning_token:/home/pw/services/volition-stack/.secrets/project_provisioning_token
LoadCredential=plan_api_key:/home/pw/services/volition-stack/.secrets/itsaplan_home_master_agent_api_key
LoadCredential=plan_control_token:/home/pw/services/volition-stack/.secrets/plan_mastra_control_token
Environment=PROVISIONING_TOKEN_FILE=%d/provisioning_token
Environment=ITSAPLAN_MCP_BEARER_FILE=%d/plan_api_key
Environment=PLAN_CONTROL_TOKEN_FILE=%d/plan_control_token
ExecStart=/usr/bin/node /home/pw/services/itsaplan/deployment/volition-stack/integration/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pw/services/volition-workspaces /var/lib/volition/project-browser/projects /home/pw/services/volition-stack/data/hermes /home/pw/Projekte/Shopify/v1-cart-suite
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=default.target
