#!/bin/sh
set -eu

credential_dir=${CREDENTIALS_DIRECTORY:?systemd credentials are unavailable}
credential_file="$credential_dir/itsaplan_api_key"
template_file=${ITSAPLAN_RUNNER_TEMPLATE:-/home/pw/services/volition-stack/integration/hermes-runner/itsaplan-runner.json}
runtime_file=${ITSAPLAN_RUNNER_CONFIG:-/home/pw/services/volition-stack/data/hermes/run/itsaplan-runner.json}
catalog_script=/home/pw/services/volition-stack/integration/scripts/volition-hermes-catalog.py
descriptor_root=${HERMES_RUNNER_DESCRIPTOR_ROOT:-/home/pw/services/volition-stack/data/hermes/run/agents}

if [ ! -r "$credential_file" ]; then
  echo "The Plan runner credential is unavailable." >&2
  exit 1
fi

ITSAPLAN_API_KEY=$(cat "$credential_file")
if [ -z "$ITSAPLAN_API_KEY" ]; then
  echo "The Plan runner credential is empty." >&2
  exit 1
fi

export ITSAPLAN_API_KEY
export HERMES_RUNNER_DESCRIPTOR_ROOT="$descriptor_root"
export HERMES_PROJECT_BROWSER_ROOT=${HERMES_PROJECT_BROWSER_ROOT:-/var/lib/volition/project-browser/projects}
export HERMES_HOME=${HERMES_HOME:-/home/pw/services/volition-stack/data/hermes}
export PYTHONPATH=/home/pw/services/hermes-agent
export PATH="$HERMES_HOME/node:/home/pw/services/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin"

/home/pw/services/hermes-agent/venv/bin/python "$catalog_script" "$template_file" "$runtime_file"
exec /usr/bin/node /home/pw/services/itsaplan/packages/runner/dist/cli.js "$runtime_file"
