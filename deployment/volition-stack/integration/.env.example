INBOX_TRIAGE_PATH=/home/pw/services/volition-workspaces/.state/integration/inbox-triage.json
INBOX_INTEGRATION_TOKEN_FILE=/home/pw/services/volition-workspaces/.state/integration/inbox-integration-token
INBOX_PUSH_TOKEN_FILE=/home/pw/services/volition-stack/.secrets/inbox_push_token
INBOX_WORKER_WAKE_URL=http://172.30.254.2:18801/internal/inbox/wake
GOG_BIN=/home/pw/.local/bin/gog
