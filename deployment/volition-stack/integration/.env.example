# Generate at least 32 random bytes. Keep the real value only in
# ~/.openclaw/volition/provisioning.env with mode 0600.
PROVISIONING_TOKEN=
PROVISIONING_HOST=127.0.0.1
PROVISIONING_PORT=18800
PROJECTS_ROOT=/home/pw/services/volition-workspaces/projects
VERVE_PROJECT_PATH=/home/pw/Projekte/Shopify/v1-cart-suite
OPENCLAW_BIN=/home/pw/.npm-global/bin/openclaw
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_PASSWORD_FILE=/run/credentials/volition-provisioning.service/openclaw_gateway_password
OPENCLAW_TRIAGE_TRANSPORT=cli
OPENCLAW_ROOT=/home/pw/.openclaw
OPENCLAW_PUBLIC_URL=https://openclaw.volition.one
BROWSER_START_URL=https://example.com
BROWSER_PROFILE=openclaw
CODE_PUBLIC_URL=https://code.volition.one
FILES_PUBLIC_URL=https://cloud.volition.one/apps/files/files
NEXTCLOUD_INTERNAL_URL=http://127.0.0.1:8092
NEXTCLOUD_HOST=cloud.volition.one
NEXTCLOUD_USER=owner@example.com
NEXTCLOUD_APP_PASSWORD_FILE=/home/pw/services/volition-stack/.secrets/nextcloud_patrick_app_password
INBOX_BASELINES={}
INBOX_PUSH_QUEUE_PATH=/home/pw/.openclaw/volition/inbox-push.json
INBOX_TRIAGE_PATH=/home/pw/.openclaw/volition/inbox-triage.json
INBOX_TRIAGE_PROMPT_ROOT=/home/pw/.openclaw/volition/triage-prompts
INBOX_INTEGRATION_TOKEN_FILE=/home/pw/.openclaw/volition/inbox-integration-token
INBOX_PUSH_TOKEN_FILE=/home/pw/services/volition-stack/.secrets/inbox_push_token
INBOX_WORKER_WAKE_URL=http://172.30.254.2:18801/internal/inbox/wake
GOG_BIN=/home/pw/.local/bin/gog
GOG_HOME=/home/pw/.local/share/openclaw-gog
GOG_KEYRING_PASSWORD_FILE=/home/pw/.local/share/openclaw-gog/keyring.pass
