# Generate at least 32 random bytes. Keep the real value only in
# /home/pw/services/volition-workspaces/.state/integration/provisioning.env with mode 0600.
PROVISIONING_TOKEN=
PROVISIONING_HOST=127.0.0.1
PROVISIONING_PORT=18800
PROJECTS_ROOT=/home/pw/services/volition-workspaces/projects
VOLITION_VAULT_ROOT=/srv/volition/vault
PROJECT_TRASH_ROOT=/srv/volition/trash/projects
PROJECT_TRASH_RETENTION_DAYS=30
PROVISIONING_STATE_ROOT=/home/pw/services/volition-workspaces/.state
VERVE_PROJECT_PATH=/home/pw/Projekte/Shopify/v1-cart-suite
INTEGRATION_STATE_ROOT=/home/pw/services/volition-workspaces/.state/integration
HERMES_HOME=/home/pw/services/volition-stack/data/hermes
HERMES_BIN=/home/pw/.local/bin/hermes
PROJECT_BROWSER_ROOT=/var/lib/volition/project-browser/projects
PROJECT_BROWSER_SYSTEMCTL_SCOPE=system
PROJECT_BROWSER_PUBLIC_URL=https://plan.volition.one/browser/
CODE_PUBLIC_URL=https://plan.volition.one/workspace/code/
TERMINAL_PUBLIC_URL=https://plan.volition.one/focus/terminal-project/
FILES_PUBLIC_URL=https://cloud.volition.one/apps/files/files
NEXTCLOUD_INTERNAL_URL=http://127.0.0.1:8092
NEXTCLOUD_HOST=cloud.volition.one
NEXTCLOUD_USER=owner@example.com
NEXTCLOUD_APP_PASSWORD_FILE=/home/pw/services/volition-stack/.secrets/nextcloud_patrick_app_password
INBOX_BASELINES={}
