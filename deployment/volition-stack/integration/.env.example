# Generate at least 32 random bytes. Kingston keeps the value in /etc/volition/provisioning.token
# (root, mode 0600) and passes it with LoadCredential= and PROVISIONING_TOKEN_FILE.
PROVISIONING_TOKEN=
PROVISIONING_HOST=127.0.0.1
PROVISIONING_PORT=18800
PROJECTS_ROOT=/srv/volition/workspaces/projects
VOLITION_VAULT_ROOT=/srv/volition/vault
PROJECT_TRASH_ROOT=/srv/volition/trash/projects
PROJECT_TRASH_RETENTION_DAYS=30
PROVISIONING_STATE_ROOT=/var/lib/volition/provisioning
INTEGRATION_STATE_ROOT=/var/lib/volition/provisioning/integration
HERMES_HOME=/var/lib/volition/hermes
HERMES_BIN=/var/lib/volition/hermes/venv/bin/hermes
PROJECT_BROWSER_ROOT=/var/lib/volition/project-browser/projects
PROJECT_BROWSER_SYSTEMCTL_SCOPE=system
PROJECT_BROWSER_PUBLIC_URL=https://plan.volition.one/browser/
CODE_PUBLIC_URL=https://plan.volition.one/workspace/code/
TERMINAL_PUBLIC_URL=https://plan.volition.one/focus/terminal-project/
NEXTCLOUD_INTERNAL_URL=http://127.0.0.1:8092
# Mail addresses (comma-separated) whose new inbox mail Plan's worker may send to Mastra triage; empty turns triage off.
INBOX_TRIAGE_ACCOUNTS=
INBOX_TRIAGE_PATH=/var/lib/volition/provisioning/integration/inbox-triage.json
INBOX_INTEGRATION_TOKEN_FILE=/var/lib/volition/provisioning/integration/inbox-integration-token
