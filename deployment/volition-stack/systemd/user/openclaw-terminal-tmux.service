[Unit]
Description=Persistent tmux session for the OpenClaw operator terminal
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=LD_LIBRARY_PATH=/home/pw/.local/opt/tmux/usr/lib/x86_64-linux-gnu
WorkingDirectory=/home/pw
ExecStart=/home/pw/.local/opt/tmux/usr/bin/tmux -L openclaw-terminal new-session -d -s main -c /home/pw
ExecStop=-/home/pw/.local/opt/tmux/usr/bin/tmux -L openclaw-terminal kill-server

[Install]
WantedBy=default.target
