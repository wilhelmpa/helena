[Unit]
Description=Volition agent egress proxy (the only way from isolated agents to the internet)
Requires=volition-egress.socket
After=network-online.target volition-egress.socket
Wants=network-online.target

[Service]
Type=simple
User=volition-egress
Group=volition-egress
ExecStart=/usr/bin/python3 -I /usr/local/lib/volition-isolation/egress.py
Environment=VOLITION_PLAN_URL=http://127.0.0.1:3000
Environment=VOLITION_USER_PREFIX=vp-
Environment=VOLITION_UNIT_PREFIX=volition-agent-
Environment=VOLITION_AGENTS_GROUP=volition-agents
LoadCredential=agent_egress_token:/etc/volition/agent-egress.token
StateDirectory=volition-egress
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
InaccessiblePaths=-/etc/volition -/var/lib/volition -/srv/volition

[Install]
WantedBy=multi-user.target
