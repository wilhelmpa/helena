# Shared .env for local dev and the self-hosting stack. Copy: cp .env.example .env
# Dev works with the values below as-is, except the secrets marked "generate one".
# Self-hosting needs real values for the secrets and public URLs; DATABASE_URL and
# S3_ENDPOINT are set by the compose file. Coolify uses docker-compose.coolify.yml.

# ── Postgres (docker-compose brings up the DB) ──
POSTGRES_USER=itsaplan
POSTGRES_PASSWORD=itsaplan
POSTGRES_DB=itsaplan
# Host port for the local dev DB. Change if 5432 is taken.
POSTGRES_PORT=5432

# ── Database connection (api + drizzle) ──
# Local; inside compose api reaches postgres by service name (postgres:5432).
DATABASE_URL=postgres://itsaplan:itsaplan@localhost:5432/itsaplan

# ── Public origins (each set once; every service derives from these) ──
# API_URL — api origin: auth handler, email links, and the origin the browser calls.
# APP_URL — web origin: CORS/auth trusted origins, passkey, email links.
API_URL=http://localhost:3000
APP_URL=http://localhost:3001

# ── Legal document URLs ──
# Shown on the logged-out screens; Google OAuth sign-in requires the privacy policy
# to be reachable. Point them at this instance's own documents. Leave empty to hide
# the legal notice. Read by web at startup, so a change needs a restart, not a build.
# PRIVACY_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms

# ── better-auth ──
BETTER_AUTH_SECRET=change-me-please-generate-a-real-secret  # openssl rand -base64 32
# Passkey (WebAuthn) relying party. Defaults to the APP_URL hostname.
# In prod set to the public frontend hostname (no scheme, no port).
# PASSKEY_RP_ID=app.example.com
# PASSKEY_RP_NAME=Its a Plan
# Cookie domain override. Defaults to the parent domain of APP_URL;
# set only for multi-label TLDs or deep subdomains.
# COOKIE_DOMAIN=.example.com
# Use host-only when web and API share an origin (for example API_URL=https://plan.example.com/backend).
# COOKIE_DOMAIN=host-only

# ── API (Elysia) ──
API_PORT=3000

# ── Database backup taken before migrations ──
# The api dumps the database on startup whenever a release has migrations to apply,
# and refuses to start when the dump fails. Dumps older than the retention window are
# removed on the next startup.
# BACKUP_RETENTION_DAYS=30
# Where the dumps are written. Under the compose files the db-backups volume pins it
# to /backups, so it only applies to an api started outside a container.
# BACKUP_DIR=/backups
# Upgrade without a dump — for an operator who backs up by other means.
# SKIP_PRE_MIGRATION_BACKUP=1

# ── File storage (attachments, document assets, skill files, avatars) ──
# Only the bytes are stored here; the metadata stays in the DB. Upload limits are DB
# settings (god mode), not env. Leave both STORAGE_ROOT and S3_* unset to disable uploads.
#
# Local disk: an absolute directory the api can write. Files are stored as plain files
# below it, and it takes precedence over S3_*. In a container it must be on a volume.
# STORAGE_ROOT=/var/lib/itsaplan/storage
#
# S3-compatible object store (MinIO in the compose files). The keys double as MinIO
# root credentials; the secret must be >= 8 chars.
S3_ENDPOINT=http://localhost:9000      # inside compose: http://minio:9000
S3_BUCKET=planner-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1                    # required by the SDK, ignored by MinIO
# Set to false for a hosted store that serves only virtual-host-style buckets
# (Railway buckets, Cloudflare R2). MinIO needs the default.
# S3_FORCE_PATH_STYLE=false

# ── Secret encryption (AI provider API keys at rest) ──
# 32-byte AES key derived from this via SHA-256. Changing it makes stored
# credentials undecryptable. openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Outbound request policy (apps/api + apps/worker) ──
# Server-side fetches of a URL that came from a request — a webhook target, an
# attachment to import, a repository host — are refused when the URL resolves to a
# loopback, link-local, or private address. Name a host here to trust it anyway.
#
# The case this exists for is a self-hosted repository host: its address is
# configuration rather than content, and on a self-hosted instance it is normally
# private, so without this a Gitea/Forgejo/GitLab on your own network cannot be
# connected at all. Exact hostnames, comma-separated; no wildcards or CIDR ranges.
# https is still required and the resolved address is still pinned.
#
# A named host is trusted by every outbound path, not only by the repository
# connection. The same list is read wherever a URL is vetted, so naming a host also
# makes it a permitted webhook target — validated by the api when a webhook is
# created or updated, and DELIVERED to by the worker — and a permitted source for
# attachment import. Anyone who can create a webhook or import an attachment can
# therefore reach a host you name here. Name only hosts you would let them reach.
#
# Set it on both the api and the worker: the api vets and the worker delivers, so a
# list on one and not the other silently applies to half the paths above.
# SSRF_ALLOWED_HOSTS=git.internal.example.com

# ── Telegram bot (apps/bot) — the bot token is stored in the DB, not here ──
# The service reads it with DATABASE_URL and APP_ENCRYPTION_KEY, set above.
# BOT_CONFIG_POLL_INTERVAL_MS=30000  # how often to re-read the bot settings
# BOT_CONFIG_RETRY_INTERVAL_MS=5000  # retry delay after the database was unreachable

# ── Background worker (apps/worker): webhooks, agent schedules, notifications ──
# Notification delivery reads the stored provider credentials, so the worker needs
# DATABASE_URL and APP_ENCRYPTION_KEY, set above.
# WEBHOOK_POLL_INTERVAL_MS=2000     # how often to poll for due deliveries
# WEBHOOK_BATCH_SIZE=20             # deliveries claimed/sent per tick
# WEBHOOK_TIMEOUT_MS=10000          # per-delivery HTTP timeout
# WEBHOOK_MAX_ATTEMPTS=8            # attempts before a delivery is dead-lettered
# WEBHOOK_DISABLE_THRESHOLD=20      # consecutive failures before a webhook is auto-disabled
# WEBHOOK_LEASE_SECONDS=120         # claim lease; a crashed delivery is retried after this
# WEBHOOK_CLEANUP_DAYS=30           # succeeded deliveries older than this are deleted
# WEBHOOK_CLEANUP_EVERY_TICKS=300   # run the cleanup once every N ticks
# NOTIFICATION_BATCH_SIZE=20        # notification deliveries claimed per tick
# NOTIFICATION_MAX_ATTEMPTS=5       # attempts before a delivery is marked failed
# NOTIFICATION_LEASE_SECONDS=120    # claim lease for crash recovery

# Mail (apps/worker). The accounts, with their encrypted passwords, are set up in the
# app. The worker imports every folder over IMAP: the raw .eml goes to STORAGE_ROOT
# (local disk only, so set it on the worker too) and attachments to PROJECT_VAULT_ROOT.
# MAIL_POLL_INTERVAL_MS=300000      # how often the folders other than the inbox are compared
# MAIL_IMPORT_BATCH_SIZE=20         # messages downloaded per batch of a first import
# MAIL_IMPORT_BATCH_BYTES=8388608   # and at most this many bytes per batch
# MAIL_IMPORT_PAUSE_MS=250          # pause after each batch
# MAIL_RETRY_MS=30000               # first wait after a failed connection, doubled
# MAIL_MAX_RETRY_MS=600000          # up to this

# Inbox triage. New inbox mail of an account with triage switched on is sent to the
# private host integration for classification. It has no built-in classifier yet (a
# Hermes classifier is an open item), so its runs fail until one exists. Leave the URL or
# the token empty to keep triage off.
# INBOX_INTEGRATION_URL=http://integration:18800
# INBOX_INTEGRATION_TOKEN=          # separate from the provisioning token
# INBOX_INTEGRATION_TIMEOUT_MS=30000

# ── Background jobs (apps/api): the agent run queue and the auto-archive sweep ──
# AGENT_RUN_POLL_INTERVAL_MS=2000   # how often to poll for due agent runs
# AGENT_RUN_BATCH_SIZE=5            # agent runs claimed per tick
# AGENT_RUN_TIMEOUT_MS=240000       # wall-clock cap on one run
# AGENT_RUN_MAX_ATTEMPTS=3          # attempts before a run is marked failed
# AGENT_RUN_LEASE_SECONDS=300       # claim lease for crash recovery
# AUTO_ARCHIVE_INTERVAL_MS=3600000  # how often the auto-archive sweep runs (own loop)

# ── Chat with an external agent (apps/api): the feed its runner drains ──
# AGENT_CHAT_LEASE_SECONDS=300      # claim lease; an abandoned answer is served again after this
# AGENT_CHAT_MAX_ATTEMPTS=3         # attempts before an answer is marked failed
# AGENT_CHAT_CLAIM_WAIT_MS=25000    # how long a runner's claim waits for work before it returns
# AGENT_CHAT_CLAIM_POLL_MS=500      # how often that claim looks for work while it waits
# AGENT_CHAT_STREAM_POLL_MS=300     # how often an open stream looks for new events
# AGENT_CHAT_HISTORY_MESSAGES=20    # thread messages sent to the runner as context

# From address for outbound email. Required for Resend (verified sender); for SMTP
# defaults to the SMTP username. NOTIFICATIONS_EMAIL_FROM is read as a fallback.
# EMAIL_FROM=Its a Plan <notifications@example.com>

# ── Web (Next.js) ──
# web reads API_URL, PRIVACY_URL and TERMS_URL from its environment at startup, so
# one image serves any instance. Local dev reads them from the separate apps/web/.env,
# which Next loads on its own.
# WEB_PORT=3001   # host port for the web app; change if 3001 is taken

# Optional web workspace surfaces. The web server reads these at startup. The
# project maps are JSON objects keyed by project key.
# HOME_CHAT_PROJECT_KEY=PRIV
# Keep these behind the existing authenticated Plan origin; the gateway routes
# only their exact prefixes to host-loopback workspace ports.
# TERMINAL_URL=https://plan.example.com/focus/terminal-project/
# CODE_URL=https://plan.example.com/workspace/code/
# PROJECT_WORKSPACE_PATHS={"VERV":"/workspace/verve"}
# BROWSER_URL=https://plan.example.com/browser/
# INBOX_URL=https://mail.example.com
# CONNECTIONS_URL=https://connections.example.com

# ── Published images ──
# The release the four services run. Unset means the newest one; pin it to stay on a
# known version. `docker compose up -d --build` ignores this and builds the checkout.
# VERSION=0.10.1

# Private, authenticated project provisioning service. Empty disables delivery.
PROJECT_PROVISIONING_URL=
PROJECT_PROVISIONING_TOKEN=
# Native systemd deployments load the private token through LoadCredential.
PROJECT_PROVISIONING_TOKEN_FILE=
# The worker reaches the host-only provisioner over the private control bridge.
# New projects request only their persistent code workspace and terminal by default.
PROJECT_PROVISIONING_TIMEOUT_MS=120000

# Optional same-origin identity-provider logout endpoint (e.g. /cdn-cgi/access/logout).
SSO_LOGOUT_URL=

# Owner browser only: distinct from the inbox worker credential.
CONNECTIONS_INTEGRATION_URL=
CONNECTIONS_INTEGRATION_TOKEN=
CONNECTIONS_INTEGRATION_TIMEOUT_MS=30000

# Bearer of the internal bootstrap routes that provisioning calls. Mount the token as a
# private read-only file in production.
PLAN_CONTROL_TOKEN_FILE=/run/secrets/plan_control_token

# ── Helena engine (apps/api): builder workflows, agent teams, routines, schedules ──
# It runs inside the api and keeps its state in its own schema of DATABASE_URL, created
# when the api starts. Everything here is optional.
# HELENA_ENGINE=off                       # run this api process without the engine
# HELENA_ENGINE_DATABASE_URL=             # another database for the engine's state
# HELENA_ENGINE_SCHEMA=helena_engine
# HELENA_ENGINE_POOL_SIZE=10              # the engine's own connections
# HELENA_ENGINE_VERSION=helena-engine-1   # keep fixed across deploys: pending workflows resume
# HELENA_ENGINE_EXECUTOR_ID=              # default: the host name; one per api replica
# HELENA_ENGINE_LOG_LEVEL=warn
# HELENA_ENGINE_POLL_MS=1000              # how often a waiting workflow checks its queue
# HELENA_ENGINE_TICK_MS=3000              # schedules, finished agent runs, lost starts
# HELENA_ENGINE_MAINTENANCE_MS=300000     # runs of gone executors, pruning
# HELENA_ENGINE_WAIT_SECONDS=             # lowers the longest wait for a signal (tests)
# HELENA_TIMEZONE=Europe/Berlin           # server default; the instance default is set in
#                                         # Administrator → Allgemein → Helena-Motor → Zeitzone

# Canonical Markdown and file vault shared by Helena and the notes (SilverBullet,
# deployment/volition-stack/native/notes). The api reads and writes it; the worker watches
# and indexes it only while this is set.
PROJECT_VAULT_ROOT=/srv/volition/vault

# Syncthing, which syncs the vault with the owner's devices (Home → Geräte).
# Native systemd deployments load the API key through LoadCredential. The LAN address is
# the one devices at home add for this server; leave it empty when discovery finds it.
SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY_FILE=/run/secrets/syncthing_api_key
SYNCTHING_LAN_ADDRESS=

# The project workspaces the Files page shows read-only as "Code" (<root>/<project slug>).
PROJECT_WORKSPACE_ROOT=/srv/volition/workspaces/projects

# The releases atom feed "Check for updates" reads. Empty: no check (this fork does not
# follow upstream releases), the history comes from CHANGELOG.md.
UPDATE_FEED_URL=

# Native project preview launcher. Existing dependencies only; no package installation.
# HELENA_PREVIEW_LAUNCHER_SOCKET=/run/volition-agent-launcher/launch.sock

# Native LAN access authenticates each person; network location is not an identity.
HELENA_LOCAL_SIGN_IN_MODE=personal

# Native model-maintenance state, written only by hostd; absence means not initialized.
VOLITION_MODEL_MAINTENANCE_STATE=/var/lib/volition/model-maintenance/state.json
