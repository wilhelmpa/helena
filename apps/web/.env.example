# Next.js reads .env only from its own folder (apps/web/.env). Copy: cp .env.example .env
# These are read by the server at startup and handed to the browser on every render,
# so a deployment sets them on the container instead (see the root .env.example).

# Public API origin the browser reaches (same value as API_URL in the root .env):
API_URL=http://localhost:3000

# Legal document URLs shown on the logged-out screens. Point them at this instance's
# own privacy policy and terms; Google OAuth sign-in requires the privacy policy to
# be reachable. Leave empty to hide the legal notice.
PRIVACY_URL=
TERMS_URL=

# Optional workspace surfaces embedded in the application shell. Leave a URL empty
# to show a clear unconfigured state for that tool.
# Project whose native chat threads back the global Home coordinator.
HOME_CHAT_PROJECT_KEY=
TERMINAL_URL=
CODE_URL=
# JSON map from project key to the code-server workspace folder.
PROJECT_WORKSPACE_PATHS=
BROWSER_URL=https://plan.volition.one/browser/
INBOX_URL=
CONNECTIONS_URL=

VAULT_UI_ENABLED=true
# Where the notes (SilverBullet on the vault) are on each of the web app's origins, as JSON:
# {"<Helena origin>": "<notes origin>"}. Written by deployment/volition-stack/native/notes/
# install.sh web; empty: no notes tool.
HELENA_NOTES_URLS=
