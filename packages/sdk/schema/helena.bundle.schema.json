{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:helena:schema:template-bundle:v1",
  "title": "Helena template bundle",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "helena.template-bundle"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "github"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "files"
                  },
                  "files": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": ["type", "files"],
                "additionalProperties": false
              }
            ]
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          }
        },
        "required": ["name", "source", "license", "attribution"],
        "additionalProperties": false
      }
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["stdio", "http", "sse"]
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["type"],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "model": {
            "type": ["string", "null"]
          },
          "effort": {
            "type": ["string", "null"]
          },
          "maxTurns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "disallowedTools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mcpServers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "helena": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string"
              },
              "roleTitle": {
                "type": "string"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runBudgetSeconds": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "triggers": {
                "type": "object",
                "properties": {
                  "mention": {
                    "type": "boolean"
                  },
                  "assign": {
                    "type": "boolean"
                  }
                },
                "required": ["mention", "assign"],
                "additionalProperties": false
              }
            },
            "required": [
              "displayName",
              "roleTitle",
              "capabilities",
              "runBudgetSeconds",
              "triggers"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "description",
          "instructions",
          "model",
          "effort",
          "maxTurns",
          "disallowedTools",
          "skills",
          "mcpServers",
          "helena"
        ],
        "additionalProperties": false
      }
    },
    "department": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "restrictedSkills": {
          "type": "boolean"
        },
        "allowedSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "enum": ["tokens", "cost", "time"]
              },
              "period": {
                "type": "string",
                "enum": ["day", "month"]
              },
              "limit": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["metric", "period", "limit"],
            "additionalProperties": false
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["coordinator", "specialist", "reviewer"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reportsTo": {
                "type": ["string", "null"]
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "heartbeat": {
                "type": "object",
                "properties": {
                  "intervalMinutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  },
                  "instructions": {
                    "type": "string"
                  }
                },
                "required": ["intervalMinutes", "timezone", "days", "start", "end", "instructions"],
                "additionalProperties": false
              },
              "budgets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "type": "string",
                      "enum": ["tokens", "cost", "time"]
                    },
                    "period": {
                      "type": "string",
                      "enum": ["day", "month"]
                    },
                    "limit": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": ["metric", "period", "limit"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["name", "role", "reportsTo", "projects", "heartbeat", "budgets"],
            "additionalProperties": false
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["planned", "active", "achieved", "paused"]
              },
              "targetDate": {
                "type": ["string", "null"]
              },
              "parent": {
                "type": ["string", "null"]
              },
              "project": {
                "type": ["string", "null"]
              }
            },
            "required": ["title", "description", "status", "targetDate", "parent", "project"],
            "additionalProperties": false
          }
        },
        "routines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "cron": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "catchUp": {
                "type": "string",
                "enum": ["skip", "once"]
              }
            },
            "required": [
              "key",
              "project",
              "agent",
              "title",
              "instructions",
              "cron",
              "timezone",
              "catchUp"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "description",
        "restrictedSkills",
        "allowedSkills",
        "budgets",
        "agents",
        "goals",
        "routines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "formatVersion",
    "name",
    "displayName",
    "version",
    "description",
    "license",
    "author",
    "skills",
    "mcpServers",
    "agents"
  ],
  "additionalProperties": false
}
