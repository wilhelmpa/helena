{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:helena:schema:plugin-manifest:v1",
  "title": "Helena plugin manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}(\\.[a-z0-9][a-z0-9-]{0,40}){0,3}$"
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "i18n": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["i18n"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "version": {
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "i18n": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["i18n"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "sdk": {
      "type": "string"
    },
    "main": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.(?:js|mjs|ts)$"
        },
        "runner": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.(?:js|mjs|ts)$"
        }
      },
      "additionalProperties": false
    },
    "provides": {
      "type": "object",
      "properties": {
        "runtimes": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "connectors": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "tools": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "stepTypes": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "triggerTypes": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "policies": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "uiSlots": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "knowledgeSources": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "captureTargets": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "bundles": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "events": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "mcpServers": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "i18n": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["i18n"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "i18n": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["i18n"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "transport": {
                "type": "string",
                "enum": ["stdio", "http"]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "toolCategories": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "read",
                    "report",
                    "write",
                    "send",
                    "publish",
                    "execute",
                    "delete",
                    "pay",
                    "credentials"
                  ]
                }
              }
            },
            "required": ["name", "transport"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "report",
              "write",
              "send",
              "publish",
              "execute",
              "delete",
              "pay",
              "credentials"
            ]
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "credentials": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["id", "name", "version", "sdk", "provides"],
  "additionalProperties": false
}
