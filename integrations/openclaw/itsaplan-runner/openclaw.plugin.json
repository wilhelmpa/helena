{
  "id": "itsaplan-runner",
  "name": "Its-a-Plan Runner",
  "description": "Routes external Its-a-Plan agent runs to fixed OpenClaw agents.",
  "categories": ["agent-runtimes"],
  "activation": {
    "onStartup": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "agents.*.apiKey",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agents"],
    "properties": {
      "baseUrl": {
        "type": "string",
        "format": "uri",
        "default": "http://127.0.0.1:3000"
      },
      "pollIntervalMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 5000
      },
      "heartbeatIntervalMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 60000,
        "default": 15000
      },
      "runTimeoutMs": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 1800000,
        "default": 600000
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 30000
      },
      "chatClaimTimeoutMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 60000,
        "default": 35000
      },
      "chatEnabled": {
        "type": "boolean",
        "default": true
      },
      "maxConcurrent": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "default": 3
      },
      "agents": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openclawAgentId", "apiKey"],
          "properties": {
            "openclawAgentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "apiKey": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source", "provider", "id"],
                  "properties": {
                    "source": {
                      "const": "store"
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
